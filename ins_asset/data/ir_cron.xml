<odoo>
    <data>
        <record id="cron_create_invoice_asset" model="ir.cron">
            <field name="name">Auto Generate Invoice Asset</field>
            <field name="model_id" ref="ins_asset.model_account_asset_depreciation_line"/>
            <field name="state">code</field>
            <field name="code">model._generate_create_move()</field>
            <field name="user_id" ref="base.user_root"/>
            <field name="interval_number">10</field>
            <field name="interval_type">minutes</field>
            <field name="numbercall">-1</field>
            <field name="nextcall" eval="(DateTime.now() + timedelta(minutes=10)).strftime('%Y-%m-%d %H:%M:%S')" />
            <field name="doall" eval="False"/>
            <field name="priority">2</field>
        </record>
    </data>
</odoo>
