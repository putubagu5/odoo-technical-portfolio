<odoo>
    <data>
        <record id="view_wizard_sell_asset_form" model="ir.ui.view">
            <field name="name">view.wizard.sell.asset.form</field>
            <field name="model">wizard.sell.asset</field>
            <field name="arch" type="xml">
                <form>
                    <sheet>
                        <group>
                            <group>
                                <field name="action" required="1"/>
                                <field name="invoice_id" attrs="{'invisible': [('action', '=', 'dispose')], 'required': [('action', '=', 'sell')]}"/>
                                <field name="invoice_name"/>
                            </group>
                            <group>
                                <field name="gain_or_loss" invisible="1"/>
                                <field name="gain_account_id" attrs="{'invisible': [('gain_or_loss', '!=', 'gain')], 'required': [('gain_or_loss', '=', 'gain')]}"/>
                                <field name="loss_account_id" attrs="{'invisible': [('gain_or_loss', '!=', 'loss')], 'required': [('gain_or_loss', '=', 'loss')]}"/>
                            </group>
                        </group>
                        <footer>
                            <button name="do_sell" type="object" string="Sell or Dispose" class="oe_highlight"/>
                            <button special="cancel" string="Cancel"/>
                        </footer>
                    </sheet>
                </form>
            </field>
        </record>
    </data>
</odoo>
