<odoo>
    <data>
        <record id="view_wizard_asset_retire" model="ir.ui.view">
            <field name="name">view.wizard.asset.retire</field>
            <field name="model">wizard.asset.retire</field>
            <field name="arch" type="xml">
                <form>
                    <group>
                        <group>
                            <field name="date_from" required="1"/>
                            <field name="date_to" required="1"/>
                        </group>
                    </group>
                    <footer>
                        <button name="print_report" string="Print" type="object" class="btn-primary"/>
                        <button string="Cancel" class="btn-default" special="cancel"/>
                    </footer>
                </form>
            </field>
        </record>

        <record id="action_wizard_asset_retire" model="ir.actions.act_window">
            <field name="name">Asset Retire</field>
            <field name="res_model">wizard.asset.retire</field>
            <field name="view_mode">form</field>
            <field name="target">new</field>
        </record>

        <menuitem
            id="menu_asset_retire"
            name="Asset Retire"
            action="action_wizard_asset_retire"
            parent="ins_asset.menu_asset"
            sequence="10"/>
    </data>
</odoo>
