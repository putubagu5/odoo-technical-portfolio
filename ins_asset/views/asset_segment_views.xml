<odoo>
    <data>
        <record id="view_asset_segment_form" model="ir.ui.view">
            <field name="name">view.asset.segment.form</field>
            <field name="model">asset.segment</field>
            <field name="arch" type="xml">
                <form>
                    <field name="active" invisible="1"/>
                    <sheet>
                        <widget name="web_ribbon" title="Archived" bg_color="bg-danger" attrs="{'invisible': [('active', '=', True)]}"/>
                        <group col="4">
                            <field name="code" required="1"/>
                            <field name="name" required="1"/>
                        </group>
                        <group>
                            <field name="note"/>
                            <field name="company_id" readonly="1"/>
                        </group>
                    </sheet>
                </form>
            </field>
        </record>

        <record id="view_asset_segment_tree" model="ir.ui.view">
            <field name="name">view.asset.segment.tree</field>
            <field name="model">asset.segment</field>
            <field name="arch" type="xml">
                <tree>
                    <field name="code"/>
                    <field name="name"/>
                    <field name="note"/>
                </tree>
            </field>
        </record>

        <record id="action_asset_segment" model="ir.actions.act_window">
            <field name="name">Asset Segment</field>
            <field name="res_model">asset.segment</field>
            <field name="view_mode">tree,form</field>
        </record>

        <menuitem
            id="menu_asset_segment"
            name="Asset Segment"
            action="action_asset_segment"
            parent="ins_asset.menu_asset_master_data"
            sequence="6"/>
    </data>
</odoo>
