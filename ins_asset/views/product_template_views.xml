<odoo>
    <data>
        <record id="product_template_form_view" model="ir.ui.view">
            <field name="name">product.template.form.view</field>
            <field name="model">product.template</field>
            <field name="inherit_id" ref="product.product_template_form_view"/>
            <field name="arch" type="xml">
            	<xpath expr="//field[@name='product_variant_id']" position="after">
            		<field name="is_cost_progress" invisible="1"/>
                    <field name="asset_model_id" attrs="{'invisible': [('is_asset','=', False), ('is_cost_progress','=', False)]}"/>
            	</xpath>
                <!-- add new tab asset models -->
                <xpath expr="//notebook" position="inside">
                    <page name="asset_model" string="Asset Models" invisible="1">
                        <field name="asset_model_ids" nolabel="1">
                            <tree editable="bottom" edit="0">
                                <field name="name"/>
                                <field name="state"/>
                            </tree>
                        </field>
                    </page>
                </xpath>

                <!-- add new div inside div options -->
                <xpath expr="//div[@name='options']" position="inside">
                    <div>
                        <field name="is_asset"/>
                        <label for="is_asset"/>
                    </div>
                </xpath>
            </field>
        </record>
    </data>
</odoo>
