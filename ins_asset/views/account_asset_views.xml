<odoo>
    <data>
        <record id="view_account_asset_form" model="ir.ui.view">
            <field name="name">view.account.asset.form</field>
            <field name="model">account.asset</field>
            <field name="inherit_id" ref="account_asset.view_account_asset_form"/>
            <field name="arch" type="xml">
                <!-- add asset_no after h1 tag in form -->
                <xpath expr="//h1" position="after">
                    <label for="asset_no" name="model_asset_no_label" string="Asset No" class="oe_edit_only"/>
                    <h3>
                        <field name="asset_no" required="1" attrs="{'readonly': [('state', 'not in', ('draft', 'model'))]}"/>
                    </h3>
                </xpath>
                <!-- <button type="object" name="compute_depreciation_board" string="Compute Depreciation" states="draft"/> -->

				<xpath expr="//button[@name='compute_depreciation_board']" position="attributes">
					<attribute name="invisible">1</attribute>
				</xpath>
                <xpath expr="//button[@name='compute_depreciation_board']" position="after">
                    <button type="object" name="compute_depreciation_list" string="Compute Depreciation" states="draft"/>
                </xpath>

                <xpath expr="//button[@name='open_entries']" position="replace">
                    <button class="oe_stat_button" name="open_entries"  type="object" icon="fa-bars">
                        <field string="Entries" name="depreciation_entries_count" widget="statinfo" />
                    </button>
                </xpath>

                <!-- add segment_id before first found group, for model -->
                <xpath expr="//field[@name='active']" position="after">
                    <group string="Segment" attrs="{'invisible': [('state', '!=', 'model')]}">
                        <field name="segment_id" attrs="{'invisible': [('state', '!=', 'model')], 'required': [('state', '=', 'model')]}"/>
                    </group>
                </xpath>
                <!-- <xpath expr="//field[@name='total_depreciation_entries_count']" position="after">
                    <field name="total_depreciation_entries_count" invisible="1"/>
                </xpath> -->

                <!-- add qty and total_duration_disposal after acquisition_date -->
                <xpath expr="//field[@name='acquisition_date']" position="after">
                    <field name="qty" invisible="1"/>
                    <field name="total_duration_disposal" attrs="{'invisible': [('state', '!=', 'close')]}" readonly="1" force_save="1"/>
                </xpath>

                <xpath expr="//field[@name='analytic_tag_ids']" position="after">
                    <field name="wilayah_id"/>
                    <field name="employee_id"/>
                </xpath>

                <!-- hide div model_box -->
                <xpath expr="//div[@name='model_box']" position="attributes">
                    <attribute name="invisible">1</attribute>
                </xpath>

                <!-- add last_location_id after first_depreciation_date -->
                <xpath expr="//field[@name='first_depreciation_date']" position="after">
                    <field name="model_id" string="Asset Category" domain="[('state', '=', 'model'), ('user_type_id', '=?', user_type_id), ('asset_type', '=', asset_type)]"/>
                    <field name="invoice_id" readonly="1"/>
                </xpath>

                <!-- modify notebook attrs -->
                <xpath expr="//notebook" position="attributes">
                    <attribute name="attrs">{'invisible': [('state', '=', 'model')]}</attribute>
                </xpath>

                <xpath expr="//page[@name='depreciation_board']" position="attributes">
                	<attribute name="invisible">1</attribute>
                </xpath>

                <xpath expr="//page[@name='depreciation_board']" position="after">
                    <page string="Depreciation Board">
                        <field name="depreciation_line_ids" mode="tree" options="{'reload_whole_on_button': true}">
                            <tree string="Depreciation Lines" decoration-info="(move_check == False)"
                                    create="false">
                                <field name="depreciation_date"/>
                                <field name="amount" widget="monetary" string="Depreciation"/>
                                <field name="depreciated_value" readonly="1"/>
                                <field name="remaining_value" readonly="1" widget="monetary" string="Residual"/>
                                <field name="move_check" widget="deprec_lines_toggler"
                                        attrs="{'invisible': [('parent_state', '!=', 'open')]}"/>
                                <field name="move_id"/>
                                <field name="move_posted_check" invisible="1"/>
                                <field name="parent_state" invisible="1"/>
                            </tree>
                            <form string="Depreciation Lines" create="false">
                                <group>
                                    <group>
                                        <field name="parent_state" invisible="1"/>
                                        <field name="name"/>
                                        <field name="sequence"/>
                                        <field name="move_id"/>
                                        <field name="move_check"/>
                                        <field name="parent_state" invisible="1"/>
                                    </group>
                                    <group>
                                        <field name="amount" widget="monetary"/>
                                        <field name="depreciation_date"/>
                                        <field name="depreciated_value"/>
                                        <field name="remaining_value"/>
                                    </group>
                                </group>
                            </form>
                        </field>
                    </page>
                </xpath>

                <!-- add new page inside notebook to contain the details -->
                <xpath expr="//notebook" position="inside">
                    <page name="asset_detail" string="Asset Details" invisible="1">
                        <group>
                            <group>
                                <field name="purchase_id"/>
                                <field name="picking_id"/>
                                <field name="date_received"/>
                                <field name="date_write_off"/>
                                <field name="date_transfer"/>
                                <field name="assignee_id"/>
                            </group>
                            <group>
                                <field name="specification"/>
                                <field name="country_id"/>
                                <field name="brand"/>
                                <field name="serial_number"/>
                                <field name="tag_number"/>
                                <field name="asset_condition_id"/>
                            </group>
                        </group>
                    </page>
                    <page name="asset_origin" string="Asset Origins">
                        <field name="origin_ids" nolabel="1">
                            <tree create="0" edit="0" delete="0">
                                <field name="move_id"/>
                                <field name="name"/>
                            </tree>
                        </field>
                    </page>
                    <page name="asset_source" string="Source">
                    	<field name="source_line_ids" nolabel="1">
                    		<tree editable="bottom" create="0" delete="0">
                    			<!-- <field name="invoice_id"/> -->
                    			<field name="invoice_name"/>
                                <field name="invoice_date"/>
                                <field name="invoice_line_number"/>
                                <!-- <field name="purchase_id"/> -->
                                <field name="purchase_name"/>
                                <field name="purchase_line_number"/>
                                <field name="description"/>
                                <field name="amount"/>
                                <field name="product_id"/>
                    		</tree>
                    	</field>
                    </page>
                </xpath>

                <!-- add button_accumulate in header -->
                <xpath expr="//header" position="inside">
                    <field name="is_accumulated" invisible="1"/>
                    <button name="button_accumulate" type="object" string="Accumulate"
                        class="oe_highlight" attrs="{'invisible': ['|', ('state', '!=', 'open'), ('is_accumulated', '=', True)]}"/>
                </xpath>

                <!-- for existing depreciation, hide first -->
                <!-- find group, then the last group, hide it -->
                <xpath expr="//group//group[last()]" position="attributes">
                    <attribute name="invisible">1</attribute>
                </xpath>

                <!-- add domain to field depreciation_move_ids -->
                <!-- <xpath expr="//field[@name='depreciation_move_ids']" position="attributes">
                    <attribute name="domain">[('depreciated', '=', True)]</attribute>
                </xpath> -->

                <!-- add amount_add before value_residual -->
                <xpath expr="//field[@name='value_residual']" position="before">
                    <field name="amount_add" invisible="1"/>
                </xpath>

                <!-- hide salvage_value -->
                <xpath expr="//field[@name='salvage_value']" position="attributes">
                    <attribute name="attrs">{'invisible': [(1, '=', 1)]}</attribute>
                </xpath>
            </field>
        </record>

        <record id="action_validate_assets" model="ir.actions.server">
            <field name="name">Confirm Assets</field>
            <field name="model_id" ref="account_asset.model_account_asset"/>
            <field name="binding_model_id" ref="account_asset.model_account_asset"/>
            <field name="state">code</field>
            <field name="code">
                if records:
                    action = records.action_validate_assets()
            </field>
        </record>

        <record id="action_sell_assets" model="ir.actions.server">
            <field name="name">Sell or Dispose Assets</field>
            <field name="model_id" ref="account_asset.model_account_asset"/>
            <field name="binding_model_id" ref="account_asset.model_account_asset"/>
            <field name="state">code</field>
            <field name="code">
                if records:
                    action = records.action_sell_assets()
            </field>
        </record>
    </data>
</odoo>
