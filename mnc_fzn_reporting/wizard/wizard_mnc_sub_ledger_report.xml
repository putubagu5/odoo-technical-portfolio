<?xml version="1.0"?>
<odoo>

    <record id="wizard_mnc_subledger_report_form" model="ir.ui.view">
        <field name="name">wizard.mnc.subledger.report.form</field>
        <field name="model">wizard.mnc.subledger.report</field>
        <field name="arch" type="xml">
            <form>
                <group>
                    <group>
                        <field name="company_id" options="{'no_create': True, 'no_open': True}" required="1"/>
                        <field name="is_date_range"/>
                        <label for="start_date" attrs="{'invisible': [('is_date_range','!=',True)]}" string="Dates"/>
                        <div class="o_row" attrs="{'invisible': [('is_date_range','!=',True)]}">
                            <field name="start_date" placeholder="Start Date"
                                   attrs="{'required': [('is_date_range','=',True)]}"/>
                            <span class="oe_inline">&#160;-&#160;</span>
                            <field name="end_date" placeholder="End Date"
                                   attrs="{'required': [('is_date_range','=',True)]}"/>
                        </div>
                        <label for="month" string="As of Period" attrs="{'invisible': [('is_date_range','=',True)]}"/>
                        <div class="o_row" attrs="{'invisible': [('is_date_range','=',True)]}">
                            <field name="month" placeholder="Select Month"
                                   attrs="{'required': [('is_date_range','!=',True)]}"/>
                            <span class="oe_inline">&#160;-&#160;</span>
                            <field name="year" placeholder="Select Year"
                                   attrs="{'required': [('is_date_range','!=',True)]}"/>
                        </div>
                        <label for="all_account" string="Account"/>
                        <div>
                            <span class="oe_inline">All&#160;</span>
                            <field name="all_account" class="oe_inline"/>
                            <field name="account_ids" widget="many2many_tags" placeholder="Select Account"
                                   options="{'no_create': True, 'no_open': True}"
                                   domain="['|',('company_id','=', company_id),('company_id','=', False)]"
                                   attrs="{'invisible': [('all_account','=',True)], 'required': [('all_account','!=',True)]}"/>
                        </div>
                    </group>
                    <group>
                        <label for="all_analytic_account" string="Cost Center"/>
                        <div>
                            <span class="oe_inline">All&#160;</span>
                            <field name="all_analytic_account" class="oe_inline"/>
                            <field name="analytic_account_ids" widget="many2many_tags" placeholder="Select Cost Center"
                                   options="{'no_create': True, 'no_open': True}"
                                   domain="['|',('company_id','=', company_id),('company_id','=', False)]"
                                   attrs="{'invisible': [('all_analytic_account','=',True)], 'required': [('all_analytic_account','!=',True)]}"/>
                        </div>
                        <label for="all_operating_unit" string="Area"/>
                        <div>
                            <span class="oe_inline">All&#160;</span>
                            <field name="all_operating_unit" class="oe_inline"/>
                            <field name="operating_unit_ids" widget="many2many_tags" placeholder="Select Area"
                                   options="{'no_create': True, 'no_open': True}"
                                   domain="['|',('company_id','=', company_id),('company_id','=', False)]"
                                   attrs="{'invisible': [('all_operating_unit','=',True)], 'required': [('all_operating_unit','!=',True)]}"/>
                        </div>
                    </group>
                </group>
                <footer>
                    <button name="button_print_excel" string="Download Excel" type="object" class="oe_highlight"/>
                    <button string="Cancel" class="oe_link" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <record model="ir.actions.act_window" id="action_wizard_mnc_subledger_report">
        <field name="name">Sub Ledger Detail Report</field>
        <field name="res_model">wizard.mnc.subledger.report</field>
        <field name="type">ir.actions.act_window</field>
        <field name="view_mode">form</field>
        <field name="view_id" ref="wizard_mnc_subledger_report_form"/>
        <field name="target">new</field>
    </record>

    <menuitem id="menu_mnc_subledger_report" parent="mnc_menu_report.report_gl" name="Sub Ledger Detail"
              action="action_wizard_mnc_subledger_report" sequence="115"/>

</odoo>