<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record id="and_report_wizard_form_view" model="ir.ui.view">
            <field name="name">and.report.wizard.form.view</field>
            <field name="model">and.report.wizard</field>
            <field name="arch" type="xml">
                <form>
                    <sheet>
                        <group>
                            <group>
                                <field name="report_type" invisible="1"/>
                                <field name="company_id"
                                       options="{'no_create': True, 'no_create_edit': True, 'no_open': True}"/>
                                <field name="date_type"/>

                                <field name="start_date" string='As of Date'
                                       attrs="{'invisible': [('date_type', '!=', 'as_of_date')], 'required': [('date_type', '=', 'as_of_date')]}"/>
                                <field name="start_date" string='Current Date'
                                       attrs="{'invisible': [('date_type', '!=', 'current_date')], 'required': [('date_type', '=', 'current_date')]}"/>
                                <label for="start_date" string="Period"
                                       attrs="{'invisible': [('date_type', '!=', 'range_of_date')]}"/>
                                <div class="o_row">
                                    <field name="start_date"
                                           attrs="{'invisible': [('date_type', '!=', 'range_of_date')], 'required': [('date_type', '=', 'range_of_date')]}"/>
                                    <field name="end_date" nolabel="1"
                                           attrs="{'invisible': [('date_type', '!=', 'range_of_date')], 'required': [('date_type', '=', 'range_of_date')]}"/>
                                </div>
                            </group>
                            <group>

                            </group>
                        </group>
                    </sheet>
                    <footer>
                        <button string="Generate Report XLSX" name="generate_report_xlsx" type="object"
                                class="oe_highlight"/>
                        <button string="Cancel" special="cancel" class="oe_link"/>
                    </footer>
                </form>
            </field>
        </record>
    </data>
</odoo>
