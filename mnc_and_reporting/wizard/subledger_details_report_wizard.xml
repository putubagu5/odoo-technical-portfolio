<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record id="subledger_details_report_wizard_form_view" model="ir.ui.view">
            <field name="name">subledger.details.report.wizard.form.view</field>
            <field name="model">subledger.details.report.wizard</field>
            <field name="inherit_id" ref="mnc_and_reporting.and_report_wizard_form_view"/>
            <field name="mode">primary</field>
            <field name="priority">1</field>
            <field name="arch" type="xml">
                <xpath expr="//sheet[1]/group[1]" position="inside">
                    <group>
                        <field name="company_id" invisible="1"/>
                        <field name="analytic_account_type" required="1"/>
                        <field name="analytic_account_ids" widget="many2many_tags"
                               attrs="{'required': [('analytic_account_type', '=', 'specific')], 'invisible': [('analytic_account_type', '!=', 'specific')]}"
                               domain="[('company_id', '=', company_id)]"
                               options="{'no_create': True, 'no_create_edit': True, 'no_edit': True}"/>

                        <field name="account_type" required="1"/>
                        <field name="account_ids" widget="many2many_tags"
                               attrs="{'required': [('account_type', '=', 'specific')], 'invisible': [('account_type', '!=', 'specific')]}"
                               domain="[('company_id', '=', company_id)]"
                               options="{'no_create': True, 'no_create_edit': True, 'no_edit': True}"/>
                    </group>
                </xpath>
            </field>
        </record>
    </data>
</odoo>
