<odoo>
    <data>
        <record model="ir.ui.view" id="inventory_costs_line_gen21_form_view">
            <field name="name">inventory.costs.line.gen21.form.view</field>
            <field name="model">inventory.costs.line.gen21</field>
            <field name="arch" type="xml">
                <form>
                     <header>
                        <field name="state" widget="statusbar" statusbar_visible="draft,wait,posted"/>
                    </header>
                    <sheet>
                        <div class="oe_title">
                            <label for="user_je_source_name" string="Source Name" style="font-weight:bold;"/>
                            <h1><field name="user_je_source_name"/></h1>
                            <label for="user_je_category_name" string="Category Name" style="font-weight:bold;"/>
                            <h4><field name="user_je_category_name"/></h4>
                            <label for="accounting_date" string="Accounting Date" style="font-weight:bold;"/>
                            <h4><field name="accounting_date"/></h4>
                        </div>
                        <group>
                            <group>
                                <field name="uniqkey"/>
                                <field name="accounted_cr"/>
                                <field name="accounted_dr"/>
                                <field name="actual_flag"/>
                                <field name="attribute1"/>
                                <field name="attribute2"/>
                                <field name="attribute3"/>
                                <field name="attribute4"/>
                                <field name="attribute5"/>
                                <field name="attribute6"/>
                                <field name="attribute7"/>
                                <field name="attribute8"/>
                                <field name="attribute9"/>
                                <field name="created_by"/>
                                <field name="date_created"/>
                            </group>
                            <group>
                                <field name="user_currency_conversion_type"/>
                                <field name="currency_conversion_date"/>
                                <field name="currency_conversion_rate"/>
                                <field name="currency_code"/>
                                <field name="entered_cr"/>
                                <field name="entered_dr"/>
                                <field name="material_id"/>
                                <field name="group_id"/>
                                <field name="ledger_id"/>
                                <field name="period_name"/>
                                <field name="rec_number"/>
                                <field name="reference1"/>
                                <field name="reference10"/>
                                <field name="reference2"/>
                                <field name="reference4"/>
                                <field name="reference5"/>
                            </group>
                        </group>
                        <group>
                            <group>
                                <field name="segment1"/>
                                <field name="segment2"/>
                                <field name="segment3"/>
                                <field name="segment4"/>
                                <field name="segment5"/>
                                <field name="segment6"/>
                                <field name="send_date"/>
                                <field name="send_flag"/>
                                <field name="send_flag_od"/>
                                <field name="update_date"/>
                                <field name="update_user"/>
                                <field name="usage_number"/>
                                <field name="usage_run_id"/>
                                <field name="status"/>
                            </group>
                        </group>
                    </sheet>
                </form>
            </field>
        </record>

        <record model="ir.ui.view" id="inventory_costs_line_gen21_tree_view">
            <field name="name">inventory.costs.line.gen21.tree.view</field>
            <field name="model">inventory.costs.line.gen21</field>
            <field name="arch" type="xml">
                <tree>
                    <field name="attribute1"/>
                    <field name="reference1"/>
                    <field name="attribute8"/>
                    <field name="company_id"/>
                    <field name="ledger_id"/>
                    <field name="user_je_source_name"/>
                    <field name="user_je_category_name"/>
                    <field name="accounting_date"/>
                    <field name="rec_number"/>
                    <field name="state" widget="badge" decoration-success="state == 'posted'" decoration-info="state == 'draft'" optional="show"/>
                </tree>
            </field>
        </record>

        <record model="ir.actions.act_window" id="inventory_costs_line_gen21_action">
            <field name="name">Inventory Costs Line</field>
            <field name="res_model">inventory.costs.line.gen21</field>
            <field name="view_mode">tree,form</field>
            <field name="domain">[]</field>
            <field name="context">{}</field>
        </record>
        
        <menuitem
            id="menu_inventory_costs_line_gen21_act"
            sequence="2"
            parent="menu_inventory_costs_gen21"
            action="inventory_costs_line_gen21_action"
        />
    </data>
</odoo>