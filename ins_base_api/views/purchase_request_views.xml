<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
    	<record id="purchase_request_inherit_form_view" model="ir.ui.view">
            <field name="name">purchase.request.inherit.form.view</field>
            <field name="model">purchase.request</field>
            <field name="inherit_id" ref="purchase_request.view_purchase_request_form"/>
            <field name="arch" type="xml">
                 <xpath expr="//button[@name='button_close']" position="after">           
                    <button name="button_canceled" states="draft,to_approve,approved" string="Cancel" type="object"/>
                 </xpath>

                  <xpath expr="//field[@name='origin']" position="after">
                        <field name="note_reason"/>
                  </xpath>  
            	  <xpath expr="//field[@name='line_ids']//tree//field[@name='product_uom_id']" position="after">
                        <field name="is_post_line_gen21" invisible="1"/>
                        <field name="uniqkey_gen21" attrs="{'invisible': [('is_post_line_gen21', '=', False)]}" optional="hide"/>
						<field name="header_attribute4" attrs="{'invisible': [('is_post_line_gen21', '=', False)]}" optional="hide"/>
				  </xpath>

                  <xpath expr="//field[@name='po_numbers']" position="after">
                        <field name="po_numbers_gen21" readonly="1"/>
                  </xpath>
            </field>
        </record>
    </data>
</odoo>