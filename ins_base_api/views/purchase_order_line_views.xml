<odoo>
    <data>
        <record id="inherit_purchase_order_line_form" model="ir.ui.view">
            <field name="name">inherit.purchase.order.line.form</field>
            <field name="model">purchase.order</field>
            <field name="inherit_id" ref="purchase.purchase_order_form"/>
            <field name="arch" type="xml">
                <xpath expr="//field[@name='product_qty']" position="before">
                    <field name="episode_no"/>
                </xpath>
            </field>
        </record>
    </data>
</odoo>