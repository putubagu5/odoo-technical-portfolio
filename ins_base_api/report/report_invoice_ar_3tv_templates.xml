<odoo>
    <template id="report_invoice_ar_3tv_container">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="o">
                <t t-call="ins_base_api.report_invoice_ar_3tv_document"/>
            </t>
        </t>
    </template>

    <template id="report_invoice_ar_3tv_document">
        <t t-call="web.basic_layout">
            <div class="page" style="font-size: 12px !important;">
                <t t-if="o.company_id.logo">
                    <img t-att-src="image_data_uri(o.company_id.logo)" class="float-left" style="max-height: 250px;max-width: 200px;  display: block;margin-left: auto;margin-right: auto;" alt="Logo"/>
                </t>
                 <div class="row">
                    <div class="col-4"></div>
                    <div class="col-4" style="border-bottom: 1px dashed;"><center>I N V O I C E</center></div>
                    <div class="col-4"></div>
                 </div>
                 <br/>
                 <br/>
                 <br/>
                 <br/>
                 <div class="row">
                    <div class="col-6">
                        <div class="row">
                            <div class="col-4">Bill To</div>
                            <div class="col-1">:</div>
                            <div class="col-7"><span t-esc="o.partner_id.name"/></div>
                        </div>
                    </div>
                    <div class="col-6">
                        <div class="row">
                            <div class="col-4">Invoice No</div>
                            <div class="col-1">:</div>
                            <div class="col-7"><span t-esc="o.payment_reference"/></div>
                        </div>
                    </div>
                   
                 </div>

                 <div class="row">
                     <div class="col-6">
                        <div class="row">
                            <div class="col-4">Address</div>
                            <div class="col-1">:</div>
                            <div class="col-7"><span t-field="o.partner_id"
                                    t-options='{"widget": "contact", "fields": ["address"], "no_marker": true}'/></div>
                        </div>
                    </div>
                    <div class="col-6">
                        <div class="row">
                            <div class="col-4">Date</div>
                            <div class="col-1">:</div>
                            <div class="col-7"><t t-esc="o.invoice_date.strftime('%d-%b-%Y')"/></div>
                        </div>
                        <div class="row">
                            <div class="col-4">Register No</div>
                            <div class="col-1">:</div>
                            <div class="col-7"><t t-esc="o.mo_numbers_gen21"/></div>
                        </div>
                    </div>
                 </div>

                 <div class="row">
                    <div class="col-6">
                        <div class="row">
                            <div class="col-4">Advertiser</div>
                            <div class="col-1">:</div>
                            <div class="col-7"><t t-esc="o.advertiser_gen21"/></div>
                        </div>
                    </div>
                    <div class="col-6">
                        <div class="row">
                            <div class="col-4">AE</div>
                            <div class="col-1">:</div>
                            <div class="col-7"><t t-esc="o.sales_person_gen21"/></div>
                        </div>
                    </div>
                 </div>
                 
                 <div class="row">
                     <div class="col-6">
                        <div class="row">
                            <div class="col-4">Order No</div>
                            <div class="col-1">:</div>
                            <div class="col-7"><t t-esc="o.po_numbers_gen21"/></div>
                        </div>
                    </div>
                 </div>
                 <br/>
                 <br/>
                 <div class="row mt-2" style="border-top: 1px dashed;border-bottom: 1px dashed;">
                    <div class="col-8"><center>Description</center></div>
                    <div class="col-4">Amount</div>
                 </div>
                 <br/>
                    <div class="row">
                        <div class="col-8">
                            <t t-esc="o.ref"/>
                            <br/>
                            <t t-set="new_line_text" t-value="line.narration.split('\n') if line.narration else ''"/>
                            <t t-foreach="new_line_text" t-as="newline">
                                <span t-esc="newline"/>
                                <br/>
                            </t>
                        </div>
                    </div>
                    <div class="row">
                        <div class="col-8">
                        </div>
                        <div class="col-4">
                            <t t-if="o.ar_receipt_type == 'iklan'">
                                <div class="row">
                                    <div class="col-5">Brand</div>
                                    <div class="col-1">:</div>
                                    <div class="col-6"><t t-esc="o.product_gen21"/></div>
                                </div>
                            </t>
                            <t t-set="gross_subtotal" t-value="0"/>
                            <t t-foreach="o.invoice_line_ids" t-as="line">
                                <t t-set="gross_subtotal" t-value="gross_subtotal + line.total_gross_gen21"/>
                            </t>
                            <t t-if="gross_subtotal &gt; 0">
                                <div class="row">
                                    <div class="col-5">Total Gross</div>
                                    <div class="col-1">:</div>
                                    <div class="col-6 text-right"><t t-esc="o.currency_id.symbol"/><t t-esc="'{:,.2f}'.format(gross_subtotal)"/></div>
                                </div>
                            </t>
                            <div class="row">
                                <div class="col-5">NETT Amount</div>
                                <div class="col-1">:</div>
                                <div class="col-6 text-right"><t t-esc="o.currency_id.symbol"/><t t-esc="'{:,.2f}'.format(o.amount_untaxed)"/></div>
                            </div>
                            <t t-set="taxes" t-value="o.get_tax_info()"/>
                            <t t-foreach="taxes" t-as="tax">
                                <div class="row">
                                    <div class="col-5">
                                        <t t-esc="tax[0]"/>
                                    </div>
                                    <div class="col-1">
                                        :
                                    </div>
                                    <div class="col-6 text-right">
                                        <t t-esc="o.currency_id.symbol"/><t t-esc="'{:,.2f}'.format(tax[1])"/>
                                    </div>
                                </div>
                            </t>
                        </div>
                    </div>

                    <div class="row">
                        <div class="col-8">
                            <div class="row">
                                <div class="col-5">Due Date</div>
                                <div class="col-1">:</div>
                                <div class="col-6"><t t-esc="o.invoice_date_due.strftime('%d-%b-%Y')"/></div>
                            </div>
                        </div>
                        <div class="col-4">
                            <div class="row">
                                <div class="col-5">Total Amount Due</div>
                                <div class="col-1">:</div>
                                <div class="col-6 text-right"><t t-esc="o.currency_id.symbol"/><t t-esc="'{:,.2f}'.format(o.amount_total)"/></div>
                            </div>
                        </div>
                    </div>
                 <br/>

                 <div class="row mt-2" style="border-top: 1px dashed; border-bottom: 1px dashed;">
                    <div class="col-3">In Words</div>
                    <div class="col-1">:</div>
                    <div class="col-8">## <t t-esc="o.amount_due_in_words"/> ##</div>
                 </div>

                 <br/>
                 <br/>
                 <div class="row">
                    <div class="col-12">
                        <pre>
Please remit to    : <t t-esc="o.company_id.name"/>
<t t-set="partner_remit" t-value="o.get_partner_remit()"/>
<t t-foreach="partner_remit" t-as="remit">
    <t t-esc="remit"/>
</t>
                        </pre>
                    </div>
                 </div>
                 <br/>
                 <br/>
                 <br/>
                 <br/>
                 <br/>
                 <div class="row">
                    <div class="col-6">
                    </div>
                    <div class="col-4">
                        <center>
                        Veronika Lawy<br/>
                        <div style="border: 1px dashed;"/><br/>
                        VP Accounting, Billing &amp; Tax 3TV
                        </center>
                    </div>
                 </div>

                 <div class="row">
                    <div class="col-12">
                        <pre>
1. Pengajuan klaim atas tagihan ini hanya dapat diterima selambat - lambatnya 14 hari kerja setelah
invoice di terima dengan melampirkan surat resmi, invoice dan faktur pajak yang ditujukan kepada
departemen accounting
2. Pembayaran yang diterima melebihi 45 hari dari tanggal invoice, dikenakan denda sebesar 1% per hari
3. Mohon mencantumkan nomor invoice pada saat melakukan pembayaran
                        </pre>
                    </div>
                 </div>
            </div>
        </t>
    </template>
</odoo>