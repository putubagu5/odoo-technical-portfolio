<odoo>
    <data>
        <record id="view_wizard_add_to_pr_form" model="ir.ui.view">
            <field name="name">view.wizard.add.to.pr.form</field>
            <field name="model">wizard.add.to.pr</field>
            <field name="arch" type="xml">
                <form>
                    <sheet>
                        <group>
                            <group>       
                                <field name="cost_ids" widget="many2many_tags" invisible="1"/>
                                <field name="request_id" required="1" domain="[('state', '=', 'draft'), ('is_post_gen21', '=', True)]"/>
                            </group>
                        </group>
                    </sheet>
                    <footer>
                        <button string="Add" name="button_add" type="object" class="oe_highlight"/>
                        <button string="Cancel" class="btn btn-secondary" special="cancel"/>
                    </footer>
                </form>
            </field>
        </record>
    </data>
</odoo>
