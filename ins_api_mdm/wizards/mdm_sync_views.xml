<odoo>
    <data>
        <record id="view_wizard_mdm_sync_form" model="ir.ui.view">
            <field name="name">view.wizard.mdm.sync.form</field>
            <field name="model">wizard.mdm.sync</field>
            <field name="arch" type="xml">
                <form>
                    <sheet>
                        <p>Click Sync to sync data from MDM</p>
                    </sheet>
                    <footer>
                        <button name="button_sync" string="Sync" type="object" class="btn-primary"/>
                        <button string="Cancel" class="btn-default" special="cancel"/>
                    </footer>
                </form>
            </field>
        </record>

        <record id="action_wizard_mdm_sync" model="ir.actions.act_window">
            <field name="name">MDM Sync</field>
            <field name="res_model">wizard.mdm.sync</field>
            <field name="view_mode">form</field>
            <field name="target">new</field>
        </record>

        <menuitem
            id="menu_wizard_mdm_sync"
            name="Sync MDM"
            action="action_wizard_mdm_sync"
            parent="purchase.menu_purchase_root"
            sequence="100"/>
    </data>
</odoo>
