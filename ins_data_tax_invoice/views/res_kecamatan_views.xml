<odoo>
    <data>
        <record id="view_res_kecamatan_form" model="ir.ui.view">
            <field name="name">view.res.kecamatan.form</field>
            <field name="model">res.kecamatan</field>
            <field name="arch" type="xml">
                <form>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="city_id"/>
                        </group>
                    </group>
                </form>
            </field>
        </record>

        <record id="view_res_kecamatan_tree" model="ir.ui.view">
            <field name="name">view.res.kecamatan.tree</field>
            <field name="model">res.kecamatan</field>
            <field name="arch" type="xml">
                <tree>
                    <field name="name"/>
                    <field name="city_id"/>
                </tree>
            </field>
        </record>

        <record id="action_res_kecamatan_form" model="ir.actions.act_window">
            <field name="name">Kecamatan</field>
            <field name="res_model">res.kecamatan</field>
            <field name="view_mode">tree,form</field>
        </record>

        <menuitem
            id="menu_kecamatan"
            action="action_res_kecamatan_form"
            parent="menu_tax_invoice_setup"
            sequence="2"/>
    </data>
</odoo>