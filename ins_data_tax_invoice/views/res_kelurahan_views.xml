<odoo>
    <data>
        <record id="view_res_kelurahan_form" model="ir.ui.view">
            <field name="name">view.res.kelurahan.form</field>
            <field name="model">res.kelurahan</field>
            <field name="arch" type="xml">
                <form>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="zip_code"/>
                            <field name="kecamatan_id"/>
                        </group>
                    </group>
                </form>
            </field>
        </record>

        <record id="view_res_kelurahan_tree" model="ir.ui.view">
            <field name="name">view.res.kelurahan.tree</field>
            <field name="model">res.kelurahan</field>
            <field name="arch" type="xml">
                <tree>
                    <field name="name"/>
                    <field name="zip_code"/>
                    <field name="kecamatan_id"/>
                </tree>
            </field>
        </record>

        <record id="action_res_kelurahan_form" model="ir.actions.act_window">
            <field name="name">Kelurahan</field>
            <field name="res_model">res.kelurahan</field>
            <field name="view_mode">tree,form</field>
        </record>

        <menuitem
            id="menu_kelurahan"
            action="action_res_kelurahan_form"
            parent="menu_tax_invoice_setup"
            sequence="3"/>
    </data>
</odoo>