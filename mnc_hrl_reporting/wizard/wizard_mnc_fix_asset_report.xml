<?xml version="1.0"?>
<odoo>

    <record id="wizard_mnc_fix_asset_report_form" model="ir.ui.view">
        <field name="name">wizard.mnc.fix.asset.report.form</field>
        <field name="model">wizard.mnc.fix.asset.report</field>
        <field name="arch" type="xml">
            <form>
                <group>
                    <group>
                        <field name="company_id" options="{'no_create': True, 'no_open': True}" required="1"/>
                        <label for="start_date" string="Dates"/>
                        <div class="o_row">
                            <field name="start_date" placeholder="Start Date" required="1"/>
                            <span class="oe_inline">&#160;-&#160;</span>
                            <field name="end_date" placeholder="End Date" required="1"/>
                        </div>
                    </group>
                    <group>

                    </group>
                </group>
                <footer>
                    <button name="button_print_excel" string="Download Excel" type="object" class="oe_highlight"/>
                    <button string="Cancel" class="oe_link" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <record model="ir.actions.act_window" id="action_wizard_mnc_fix_asset_report">
        <field name="name">Fix Asset Report</field>
        <field name="res_model">wizard.mnc.fix.asset.report</field>
        <field name="type">ir.actions.act_window</field>
        <field name="view_mode">form</field>
        <field name="view_id" ref="wizard_mnc_fix_asset_report_form"/>
        <field name="target">new</field>
    </record>

</odoo>