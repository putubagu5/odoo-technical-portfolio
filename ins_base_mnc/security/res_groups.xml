<odoo>
    <data>
        <!-- create new category for buyer -->
        <record model="ir.module.category" id="module_category_res_buyer">
            <field name="name">Buyer</field>
            <field name="description">Buyer Category</field>
        </record>

        <record id="group_buyer_own" model="res.groups">
            <field name="name">Own Records</field>
            <field name="comment">User can view only his/her buyer records</field>
            <field name="category_id" ref="ins_base_mnc.module_category_res_buyer"/>
            <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
        </record>

        <record id="group_buyer_super" model="res.groups">
            <field name="name">Super</field>
            <field name="comment">User can view all buyer records</field>
            <field name="category_id" ref="ins_base_mnc.module_category_res_buyer"/>
            <field name="implied_ids" eval="[(4, ref('ins_base_mnc.group_buyer_own'))]"/>
            <field name="users" eval="[(4, ref('base.user_root')), (4, ref('base.user_admin'))]"/>
        </record>

        <record id="group_forbidden" model="res.groups">
            <field name="name">CCCP</field>
            <field name="users" eval="[(4, ref('base.user_root')), (4, ref('base.user_admin'))]"/>
        </record>

        <record id="group_super_admin" model="res.groups">
            <field name="name">Super Admin</field>
            <field name="users" eval="[(4, ref('base.user_root')), (4, ref('base.user_admin'))]"/>
        </record>

    </data>
</odoo>
