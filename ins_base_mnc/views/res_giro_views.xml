<odoo>
    <data>
        <record id="view_res_giro_form" model="ir.ui.view">
            <field name="name">view.res.giro.form</field>
            <field name="model">res.giro</field>
            <field name="inherit_id" ref="ins_accounting.view_res_giro_form"/>
            <field name="arch" type="xml">
                <!-- add widget one2many_delete to field line_ids -->
                <xpath expr="//field[@name='line_ids']" position="attributes">
                    <attribute name="widget">one2many_delete</attribute>
                </xpath>
            </field>
        </record>
    </data>
</odoo>
