<odoo>
    <data>
        <record id="view_stock_move_operations" model="ir.ui.view">
            <field name="name">view.stock.move.operations</field>
            <field name="model">stock.move</field>
            <field name="inherit_id" ref="stock.view_stock_move_operations"/>
            <field name="arch" type="xml">
                <!-- add valid_location_ids after picking_id, make invisible -->
                <xpath expr="//field[@name='picking_id']" position="after">
                    <field name="valid_location_ids" widget="many2many_tags" invisible="1"/>
                </xpath>
            </field>
        </record>

        <record id="view_stock_move_nosuggest_operations" model="ir.ui.view">
            <field name="name">view.stock.move.nosuggest.operations</field>
            <field name="model">stock.move</field>
            <field name="inherit_id" ref="stock.view_stock_move_nosuggest_operations"/>
            <field name="arch" type="xml">
                <!-- add valid_location_ids before move_line_nosuggest_ids, make invisible -->
                <xpath expr="//field[@name='move_line_nosuggest_ids']" position="before">
                    <field name="valid_location_ids" widget="many2many_tags" invisible="1"/>
                </xpath>
            </field>
        </record>
    </data>
</odoo>
