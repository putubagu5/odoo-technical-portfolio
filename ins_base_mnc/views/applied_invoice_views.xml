<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record id="inherit_applied_invoices_form" model="ir.ui.view">
            <field name="name">inherit.applied.invoices.form</field>
            <field name="model">applied.invoices</field>
            <field name="inherit_id" ref="ins_miscellaneous.view_applied_invoices_form"/>
            <field name="arch" type="xml">
                <xpath expr="//field[@name='state']" position="before">
                    <field name="is_cancel_reversal" invisible="1" />
                </xpath>
<!--                <xpath expr="//button[@name='action_applied_invoice']" position="before">-->
<!--                    <button name="action_draft" string="Reset To Draft" type="object"-->
<!--                        class="btn btn-secondary"-->
<!--                        attrs="{'invisible': [('state', 'not in', ('posted', 'cancel'))]}"-->
<!--                        groups="account.group_account_invoice"/>-->
<!--                </xpath>-->
                <xpath expr="//button[@name='action_unapplied_invoice']" position="replace">
                    <button
                        name="cancel_reversal_x"
                        string="Unapplied Invoice (Reversal Move)"
                        type="object"
                        attrs="{'invisible': ['|', '|',('state', '!=', 'posted'), ('is_cancel_reversal', '=', False),
                        ('reverse_date', '!=', False)]}"
                    />
                </xpath>
                <xpath expr="//field[@name='move_id']" position="after">
                    <field
                        name="reverse_date"
                        attrs="{'invisible': [('reverse_date', '=', False)], 'readonly':[('state', '=', 'posted')]}"
                    />
                    <field
                        name="reverse_user_by"
                        attrs="{'invisible': [('reverse_user_by', '=', False)], 'readonly':[('state', '=', 'posted')]}"
                    />
                    <field
                        name="reverse_reason"
                        attrs="{'invisible': [('reverse_reason', '=', False)], 'readonly':[('state', '=', 'posted')]}"
                    />
                </xpath>
            </field>
        </record>

    </data>
</odoo>