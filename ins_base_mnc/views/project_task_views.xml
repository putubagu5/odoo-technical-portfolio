<odoo>
    <data>
        <record id="view_task_form2" model="ir.ui.view">
            <field name="name">view.task.form2</field>
            <field name="model">project.task</field>
            <field name="inherit_id" ref="project.view_task_form2"/>
            <field name="arch" type="xml">
                <!-- add date_estimate_start and date_estimate_end before date_deadline -->
                <xpath expr="//field[@name='date_deadline']" position="before">
                    <label for="date_estimate_start" string="Estimation Shoot Date"/>
                    <div>
                        <field name="date_estimate_start" class="oe_inline"/> - <field name="date_estimate_end" class="oe_inline"/>
                    </div>   
                </xpath>

                <!-- add phase_type, episode_number, day_number, duration, group_type after partner_id -->
                <xpath expr="//field[@name='partner_id']" position="after">
                    <field name="phase_type"/>
                    <field name="episode_number"/>
                    <field name="day_number"/>
                    <field name="duration"/>
                    <field name="group_type"/>
                </xpath>
            </field>
        </record>
    </data>
</odoo>
