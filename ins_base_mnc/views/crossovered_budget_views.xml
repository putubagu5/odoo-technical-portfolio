<odoo>
    <data>
        <record id="crossovered_budget_view_form" model="ir.ui.view">
            <field name="name">crossovered.budget.view.form</field>
            <field name="model">crossovered.budget</field>
            <field name="inherit_id" ref="account_budget.crossovered_budget_view_form"/>
            <field name="arch" type="xml">
                <!-- put operating_unit_id after company_id -->
                <xpath expr="//field[@name='company_id']" position="after">
                    <field name="operating_unit_id" string="Wilayah" attrs="{'readonly':[('state','=','validate')]}"/>
                </xpath>

                <!-- put budget_category_id after user_id -->
                <xpath expr="//field[@name='user_id']" position="after">
                    <field name="budget_category_id" attrs="{'readonly':[('state','=','validate')]}"/>
                </xpath>
            </field>
        </record>
    </data>
</odoo>
