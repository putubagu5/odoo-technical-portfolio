<odoo>
    <data>
        <record id="view_picking_type_form" model="ir.ui.view">
            <field name="name">view.picking.type.form</field>
            <field name="model">stock.picking.type</field>
            <field name="inherit_id" ref="stock.view_picking_type_form"/>
            <field name="arch" type="xml">
                <!-- add use_product_expense after show_reserved, show if code is outgoing -->
                <xpath expr="//field[@name='show_reserved']" position="after">
                    <field name="use_product_expense" attrs="{'invisible': [('code', '!=', 'outgoing')]}"/>
                </xpath>
            </field>
        </record>
    </data>
</odoo>
