<odoo>
    <data>
        <record id="view_res_partner_type_form" model="ir.ui.view">
            <field name="name">view.res.partner.type.form</field>
            <field name="model">res.partner.type</field>
            <field name="arch" type="xml">
                <form>
                    <sheet>
                        <group>
                            <group>
                                <field name="name" required="1"/>
                                <field name="code" required="1"/>
                            </group>
                        </group>
                    </sheet>
                </form>
            </field>
        </record>

        <record id="view_res_partner_type_tree" model="ir.ui.view">
            <field name="name">view.res.partner.type.tree</field>
            <field name="model">res.partner.type</field>
            <field name="arch" type="xml">
                <tree>
                    <field name="name"/>
                    <field name="code"/>
                </tree>
            </field>
        </record>

        <record id="action_res_partner_type" model="ir.actions.act_window">
            <field name="name">Partner Type</field>
            <field name="res_model">res.partner.type</field>
            <field name="view_mode">tree,form</field>
        </record>

        <menuitem
            id="menu_res_partner_type_customer"
            name="Partner Type"
            action="action_res_partner_type"
            parent="account.menu_finance_receivables"
            sequence="300"/>

        <menuitem
            id="menu_res_partner_type_vendor"
            name="Partner Type"
            action="action_res_partner_type"
            parent="account.menu_finance_payables"
            sequence="300"/>
    </data>
</odoo>
