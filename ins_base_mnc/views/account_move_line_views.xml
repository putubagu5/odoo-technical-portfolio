<odoo>
    <data>
        <record id="view_move_line_form" model="ir.ui.view">
            <field name="name">view.move.line.form</field>
            <field name="model">account.move.line</field>
            <field name="inherit_id" ref="account.view_move_line_form"/>
            <field name="arch" type="xml">
                <xpath expr="//page[@name='information']//group//group[9]" position="after">
                    <group string="AR Reference">
                        <field name="ref_receipt"/>
                        <field name="ref_misc_receipt"/>
                    </group>
                    <group string="AP Reference">
                        <field name="ref_payment"/>
                        <field name="ref_misc_payment"/>
                    </group>
                </xpath>
            </field>
        </record>

        <record id="view_move_line_tree" model="ir.ui.view">
            <field name="name">view.move.line.tree</field>
            <field name="model">account.move.line</field>
            <field name="inherit_id" ref="account.view_move_line_tree"/>
            <field name="arch" type="xml">
                <!-- add rate, tax_invoice_id, and reference fields before matching_number -->
                <xpath expr="//field[@name='matching_number']" position="before">
                    <field name="rate" optional="show"/>
                    <field name="tax_invoice_id" optional="show"/>
                    <field name="ref_receipt" optional="hide"/>
                    <field name="ref_misc_receipt" optional="hide"/>
                    <field name="ref_payment" optional="hide"/>
                    <field name="ref_misc_payment" optional="hide"/>
                </xpath>
            </field>
        </record>
    </data>
</odoo>
