<odoo>
    <data>
        <record id="view_order_form" model="ir.ui.view">
            <field name="name">view.order.form</field>
            <field name="model">sale.order</field>
            <field name="inherit_id" ref="sale.view_order_form"/>
            <field name="arch" type="xml">
                <!-- put amount_in_words after note -->
                <xpath expr="//field[@name='note']" position="after">
                    <field name="amount_in_words" readonly="1"/>
                    <field name="amount_in_words_2" invisible="1"/>
                </xpath>
                <xpath expr="//field[@name='partner_id']" position="after">
                    <field name="assignee_id"/>
                </xpath>

                <!-- make these field invisible for digits display to work -->
                <xpath expr="//field[@name='order_line']//tree//field[@name='product_uom_qty']" position="replace">
                    <field name="product_uom_qty" id="product_uom_qty_default" invisible="1"/>
                    <field name="product_uom_qty" id="product_uom_qty_cust" digits="[12, 2]" optional="show"/>
                </xpath>
                <xpath expr="//field[@name='order_line']//tree//field[@name='price_unit']" position="replace">
                    <field name="price_unit" id="price_unit_default" invisible="1"/>
                    <field name="price_unit" id="price_unit_cust" digits="[12, 2]" optional="show"/>
                </xpath>
            </field>
        </record>

        <record id="sale.action_report_saleorder" model="ir.actions.report">
            <field name="binding_model_id" eval="False"/>
        </record>
    </data>
</odoo>
