<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>

        <record id="master_episode_form_view" model="ir.ui.view">
            <field name="name">purchase.master.episode.form</field>
            <field name="model">purchase.master.episode</field>
            <field name="arch" type="xml">
                <form string="Episode">
                    <sheet>
                        <group>
                            <group>
                                <field name="name"/>
                            </group>
                        </group>
                    </sheet>
                </form>
            </field>
        </record>

        <record id="master_episode_tree_view" model="ir.ui.view">
            <field name="name">purchase.master.episode.tree</field>
            <field name="model">purchase.master.episode</field>
            <field name="arch" type="xml">
                <tree string="Episode">
                    <field name="name"/>
                </tree>
            </field>
        </record>

        <record id="master_episode_act_window" model="ir.actions.act_window">
            <field name="name">Master Episode</field>
            <field name="type">ir.actions.act_window</field>
            <field name="res_model">purchase.master.episode</field>
            <field name="view_mode">tree,form</field>
            <field name="help" type="html">
                <p class="oe_view_nocontent_create">
                    There is no examples click here to add new Master Episode.
                </p>
            </field>
        </record>

        <menuitem name="Master Episode" id="master_episode_menu" parent="purchase.menu_purchase_config" action="master_episode_act_window"/>

    </data>
</odoo>