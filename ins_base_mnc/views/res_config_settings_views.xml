<odoo>
    <data>
        <record id="res_config_settings_view_form" model="ir.ui.view">
            <field name="name">res.config.settings.view.form</field>
            <field name="model">res.config.settings</field>
            <field name="inherit_id" ref="account.res_config_settings_view_form"/>
            <field name="arch" type="xml">
                <xpath expr="//field[@name='module_currency_rate_live']" position="replace">
                    <field name="module_currency_rate_live"/>
                </xpath>
                <xpath expr="//field[@name='module_account_budget']" position="replace">
                    <field name="module_account_budget"/>
                </xpath>
                <xpath expr="//field[@name='module_account_batch_payment']" position="replace">
                    <field name="module_account_batch_payment"/>
                </xpath>
            </field>
        </record>

        <record id="res_company_view_form" model="ir.ui.view">
            <field name="name">res.company.view.form</field>
            <field name="model">res.company</field>
            <field name="inherit_id" ref="base.view_company_form"/>
            <field name="arch" type="xml">
                <xpath expr="//notebook/page/group" position="after">
                    <group string="Asset">
                        <field name="gain_account_id" />
                        <field name="loss_account_id" />
                    </group>
                </xpath>
                <xpath expr="//field[@name='phone']" position="before">
                    <field name="invoice_address_po"/>
                </xpath>
            </field>
        </record>
    </data>
</odoo>
