<odoo>
    <data>
        <record id="view_res_company_logo_form" model="ir.ui.view">
            <field name="name">view.res.company.logo.form</field>
            <field name="model">res.company.logo</field>
            <field name="arch" type="xml">
                <form>
                    <sheet>
                        <div class="oe_title">
                            <label for="active" string="Active"/>
                            <field name="active" widget="boolean_toogle"/>
                        </div>
                        <group>
                            <group>
                                <field name="image" widget="image" options="{'zoom': true}" required="1"/>
                            </group>
                        </group>
                    </sheet>
                </form>
            </field>
        </record>

        <record id="view_res_company_logo_tree" model="ir.ui.view">
            <field name="name">view.res.company.logo.tree</field>
            <field name="model">res.company.logo</field>
            <field name="arch" type="xml">
                <tree>
                    <field name="active"/>
                    <field name="image"/>
                </tree>
            </field>
        </record>

        <record id="action_res_company_logo" model="ir.actions.act_window">
            <field name="name">Company Group Logo</field>
            <field name="res_model">res.company.logo</field>
            <field name="view_mode">tree,form</field>
        </record>

        <menuitem
            id="menu_res_company_logo"
            name="Company Group Logo"
            action="action_res_company_logo"
            parent="base.menu_users"
            sequence="60"/>
    </data>
</odoo>
