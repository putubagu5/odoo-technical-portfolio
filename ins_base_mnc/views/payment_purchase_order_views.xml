<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>

        <record id="view_payment_purchase_order_form" model="ir.ui.view">
            <field name="name">view.payment.purchase.order.form</field>
            <field name="model">payment.purchase.order</field>
            <field name="arch" type="xml">
                <form string="Payment Agreement">
                <sheet>
                    <group>
                        <group>
                            <field name="name" readonly="1"/>
                            <field name="purchase_id"/>
                            <field name="pr_numbers"/>
                            <field name="rr_numbers"/>
                            <field name="request_date" readonly="1"/>
                            <field name="due_date" required="1"/>
                            <field name="paid_on_behalf"/>
                            <field name="invoice_number" required="1"/>
                            <field name="faktur_number" required="1"/>
                            <field name="berita_acara_number"/>
                            <field name="contract"/>
                            <field name="uat"/>
                            <field name="description_payment" required="1"/>
                            <field name="currency_id" required="1"/>
                            <field name="dpp_amount" required="1"/>
                            <field name="vat"/>
                            <field name="vat_amount"/>
                            <field name="income_tax"/>
                            <field name="income_tax_amount"/>
                        </group>
                    </group>
                </sheet>
                </form>
            </field>
        </record>

        <record id="view_payment_purchase_order_tree" model="ir.ui.view">
            <field name="name">view.payment.purchase.order.tree</field>
            <field name="model">payment.purchase.order</field>
            <field name="arch" type="xml">
                <tree string="Payment Agreement">
                    <field name="name"/>
                    <field name="purchase_id"/>
                    <field name="pr_numbers"/>
                    <field name="rr_numbers"/>
                    <field name="request_date"/>
                    <field name="due_date"/>
                </tree>
            </field>
        </record>

        <record id="action_payment_purchase_order_form" model="ir.actions.act_window">
            <field name="name">Payment Agreement</field>
            <field name="res_model">payment.purchase.order</field>
            <field name="view_mode">tree,form</field>
            <field name="help" type="html">
              <p class="o_view_nocontent_smiling_face">
                Create a Payment Agreement
              </p>
            </field>
        </record>
        
        
        <menuitem
            action="action_payment_purchase_order_form"
            id="menu_payment_purchase_order"
            parent="purchase.menu_procurement_management"
        />

    </data>
</odoo>
