<odoo>
    <data>
        <record id="res_currency_view_form_inherit" model="ir.ui.view">
            <field name="name">res.currency.view.form.inherit</field>
            <field name="model">res.currency</field>
            <field name="inherit_id" ref="base.view_currency_form"/>
            <field name="arch" type="xml">
                <xpath expr="//field[@name='rate']" position="after">
                    <field name="actual_rate"/>
                    <field name="actual_rate_date"/>
                </xpath>
            </field>
        </record>
    </data>
</odoo>