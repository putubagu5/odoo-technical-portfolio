<odoo>
    <data>
        <record id="view_picking_form" model="ir.ui.view">
            <field name="name">view.picking.form</field>
            <field name="model">stock.picking</field>
            <field name="inherit_id" ref="stock.view_picking_form"/>
            <field name="arch" type="xml">
                <!-- add valid_location_ids and allowed_user_ids after origin, hide -->
                <xpath expr="//field[@name='origin']" position="after">
                    <field name="valid_location_ids" widget="many2many_tags" invisible="1"/>
                    <field name="allowed_user_ids" widget="many2many_tags" invisible="1"/>
                    <field name="assignee_id"/>
                    <field name="buyer_id" attrs="{'invisible': [('picking_type_code', '!=', 'incoming')]}"/>
                </xpath>

                <!-- add domain to location_dest_id to pick only from valid_location_ids -->
                <xpath expr="//field[@name='location_dest_id']" position="attributes">
                    <attribute name="domain">[('id', 'in', valid_location_ids)]</attribute>
                </xpath>

                <xpath expr="//field[@name='location_dest_id']" position="after">
                    <field name="po_numbers" attrs="{'invisible': [('picking_type_code', '!=', 'incoming')]}"/>
                    <!-- <field name="po_numbers_store"/> -->
                    <field name="pr_numbers" attrs="{'invisible': [('picking_type_code', '!=', 'incoming')]}"/>
                    <!-- <field name="requestor" invisible="1"/> -->
                    <field name="requestor_comp" attrs="{'invisible': [('picking_type_code', '!=', 'incoming')]}"/>
                    <field name="document"/>
                    <field name="is_returned" invisible="1"/>
                </xpath>

                <!-- add line_number before product_id in tree -->
                <xpath expr="//page[@name='operations']//field[@name='move_ids_without_package']//tree//field[@name='product_id']" position="before">
                    <field name="line_number" readonly="1" force_save="1" optional="hide"/>
                    <field name="purchase_request_number" force_save="1" optional="hide"/>
                    <field name="purchase_order_number" force_save="1" optional="hide"/>
                    <field name="requested_by" force_save="1" optional="hide"/>
                </xpath>

                <!-- make these field invisible for digits display to work -->
                <xpath expr="//field[@name='move_ids_without_package']//tree//field[@name='product_uom_qty']" position="replace">
                    <field name="product_uom_qty" id="product_uom_qty_default" invisible="1"/>
                    <field name="product_uom_qty" id="product_uom_qty_cust" digits="[12, 2]" optional="show"/>
                </xpath>
                <xpath expr="//field[@name='move_ids_without_package']//tree//field[@name='quantity_done']" position="replace">
                    <field name="quantity_done" id="quantity_done_default" invisible="1"/>
                    <field name="quantity_done" id="quantity_done_cust" digits="[12, 2]" optional="show"/>
                </xpath>
                <xpath expr="//field[@name='move_ids_without_package']//tree//field[@name='quantity_done']" position="after">
                	<field name="quantity_return" optional="show" readonly="1"/>
                    <field name="amount_total" optional="hide"/>
                </xpath>

                <!-- add purchase_line_number before product_uom_qty in tree -->
                <xpath expr="//page[@name='operations']//field[@name='move_ids_without_package']//tree//field[@name='product_uom_qty']" position="before">
                    <field name="purchase_line_number" readonly="1" force_save="1" optional="hide"/>
                </xpath>

                <xpath expr="//page[@name='operations']//field[@name='move_ids_without_package']//tree//field[@name='product_id']" position="attributes">
                    <attribute name="optional">show</attribute>
                </xpath>

                <xpath expr="//page[@name='operations']//field[@name='move_ids_without_package']//tree//field[@name='analytic_account_id']" position="attributes">
                    <attribute name="optional">show</attribute>
                </xpath>

                <xpath expr="//page[@name='operations']//field[@name='move_ids_without_package']//tree//field[@name='product_uom']" position="after">
                    <field name="qty_invoiced" attrs="{'invisible': [('parent.picking_type_code', '!=', 'incoming')]}" optional="show"/>
                    <field name="qty_avail_to_bill" attrs="{'invisible': [('parent.picking_type_code', '!=', 'incoming')]}" optional="show"/>
                </xpath>
            </field>
        </record>

        <record id="view_picking_internal_search" model="ir.ui.view">
            <field name="name">view.picking.internal.search</field>
            <field name="model">stock.picking</field>
            <field name="inherit_id" ref="stock.view_picking_internal_search"/>
            <field name="arch" type="xml">
                <!-- add my_receipts before draft -->
                <xpath expr="//filter[@name='draft']" position="before">
                    <filter name="my_receipts" string="My Receipts" domain="[('allowed_user_ids', 'in', uid)]"/>
                    <separator/>
                </xpath>
            </field>
        </record>

        <record id="view_picking_tree" model="ir.ui.view">
            <field name="name">view.picking.tree</field>
            <field name="model">stock.picking</field>
            <field name="inherit_id" ref="stock.vpicktree"/>
            <field name="arch" type="xml">
                <xpath expr="//field[@name='origin']" position="after">
                    <field name="buyer_id" optional="hide"/>
                    <field name="po_numbers" optional="show"/>
                    <!-- <field name="po_numbers_store" optional="show"/> -->
                    <field name="pr_numbers" optional="hide"/>
                    <field name="requestor_comp" optional="hide"/>
                    <field name="document" optional="hide"/>
                </xpath>
            </field>
        </record>
    </data>
</odoo>
