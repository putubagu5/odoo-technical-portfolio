<odoo>
    <data>
        <record id="view_account_asset_form" model="ir.ui.view">
            <field name="name">view.account.asset.form</field>
            <field name="model">account.asset</field>
            <field name="inherit_id" ref="account_asset.view_account_asset_form"/>
            <field name="arch" type="xml">
                <!-- add atis_number after -->
                <xpath expr="//field[@name='first_depreciation_date']" position="after">
                    <field name="atis_number"/>
                </xpath>

                <!-- add amount_depreciated after value_residual -->
                <xpath expr="//field[@name='value_residual']" position="after">
                    <field name="amount_depreciated"/>
                </xpath>

                <!-- hide value_residual -->
                <xpath expr="//field[@name='value_residual']" position="attributes">
                    <attribute name="invisible">1</attribute>
                </xpath>
            </field>
        </record>
    </data>
</odoo>
