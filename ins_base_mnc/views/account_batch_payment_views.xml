<odoo>
    <data>
        <record id="view_batch_payment_form" model="ir.ui.view">
            <field name="name">view.batch.payment.form</field>
            <field name="model">account.batch.payment</field>
            <field name="inherit_id" ref="account_batch_payment.view_batch_payment_form"/>
            <field name="arch" type="xml">
                <!-- add is_check and check_no after name -->
                <xpath expr="//field[@name='name']" position="after">
                    <field name="is_check" invisible="1"/>
                    <label for="check_no" string="Check Number" attrs="{'invisible': [('is_check', '=', False)]}"/>
                    <div class="d-flex" attrs="{'invisible': [('is_check', '=', False)]}">
                        <field name="check_no" readonly="1" force_save="1"/>
                        <span class="oe_inline o_form_label mx-8 oe_read_only"> </span>
                        <button name="button_check" type="object" string="Check" class="oe_highlight"
                            attrs="{'invisible': ['|', ('is_check', '=', False), ('state', 'not in', ('draft'))]}"/>
                    </div>
                </xpath>

                <!-- add check_no from payment in field payment_ids in tree section after partner_id -->
                <xpath expr="//field[@name='payment_ids']//tree//field[@name='partner_id']" position="after">
                    <!-- NOTE: add valid_partner_ids due to payment_ids -->
                    <field name="valid_partner_ids" invisible="1"/>
                    <field name="is_check" invisible="1"/>
                    <field name="check_no" attrs="{'readonly': [('is_check', '=', False)], 'required': [('is_check', '=', True)]}"/>
                </xpath>

                <xpath expr="//field[@name='payment_ids']//form//group//group//field[@name='partner_id']" position="after">
                    <!-- NOTE: add valid_partner_ids due to payment_ids -->
                    <field name="valid_partner_ids" invisible="1"/>
                </xpath>
            </field>
        </record>
    </data>
</odoo>
