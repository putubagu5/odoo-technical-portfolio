<odoo>
    <data>
      <record id="inherit_product_template_inherit_form" model="ir.ui.view">
            <field name="name">product.template.inherit</field>
            <field name="model">product.template</field>
            <field name="inherit_id" ref="purchase.view_product_supplier_inherit"/>
            <field name="arch" type="xml">
                <group name="bill" position="after">
                    <group string="PO Percent Tolerance">
                        <field name="price_tolerance" required="1"/>
                    </group>
                </group>

                <!-- add buyer_ids inside bill group -->
                <xpath expr="//group[@name='bill']" position="inside">
                    <field name="buyer_id" invisible="1"/>
                    <field name="buyer_ids" widget="many2many_tags"/>
                </xpath>
            </field>
      </record>
    </data>
</odoo>