<odoo>
    <data>
        <record id="view_res_assignee_pr_tree" model="ir.ui.view">
            <field name="name">view.res.assignee.pr.tree</field>
            <field name="model">res.assignee.pr</field>
            <field name="arch" type="xml">
                <tree editable="bottom">
                    <field name="doc_position" required="1"/>
                    <field name="name" required="1"/>
                    <field name="job_position" required="1"/>
                    <field name="company_ids" required="1" widget="many2many_tags"/>
                </tree>
            </field>
        </record>

        <record id="view_res_assignee_pr_form" model="ir.ui.view">
            <field name="name">view.res.assignee.pr.form</field>
            <field name="model">res.assignee.pr</field>
            <field name="arch" type="xml">
                <form>
                    <sheet>
                        <group>
                            <group>
                                <field name="doc_position" required="1"/>
                                <field name="name" required="1"/>
                                <field name="job_position" required="1"/>
                                <field name="company_ids" required="1" widget="many2many_tags"/>
                            </group>
                        </group>
                    </sheet>
                </form>
            </field>
        </record>

        <record id="action_res_assignee_pr" model="ir.actions.act_window">
            <field name="name">Assignee (PR)</field>
            <field name="res_model">res.assignee.pr</field>
            <field name="view_mode">tree,form</field>
        </record>

        <menuitem
            id="menu_assignee_pr"
            name="Master Data Assignee (PR)"
            action="action_res_assignee_pr"
            parent="purchase_request.menu_purchase_request"/>
    </data>
</odoo>
