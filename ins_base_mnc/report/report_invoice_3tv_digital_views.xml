                                    <div class="col-4">Sales Office</div>
                                    <div class="col-1">:</div>
                                    <div class="col-7"></div>
                                </div>
                                <div class="row">
                                    <div class="col-4">Sales Person</div>
                                    <div class="col-1">:</div>
                                    <div class="col-7"></div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="row">
                    <div class="col-8" style="border: 1px solid black"><strong>Description</strong></div>
                    <div class="col-4" style="border: 1px solid black"><strong>Amount</strong></div>
                </div>

                <div class="row">
                    <div class="col-8" style="border: 1px solid black">
                        <div class="row">
                            <div class="col-6">
                            </div>
                            <div class="col-6">
                            </div>
                        </div>
                    </div>
                    <div class="col-4" style="border: 1px solid black">
