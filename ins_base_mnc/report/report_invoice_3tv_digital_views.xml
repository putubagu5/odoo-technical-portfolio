                                    <div class="col-4">TX / Channel</div>
                                    <div class="col-1">:</div>
                                    <div class="col-7"></div>
                                </div>
                                <div class="row">
                                    <div class="col-4">Description</div>
                                    <div class="col-1">:</div>
                                    <div class="col-7"></div>
                                </div>
                            </div>
                            <div class="col-6">
                                <div class="row">
                                    <div class="col-4">Invoice No</div>
                                    <div class="col-1">:</div>
                                    <div class="col-7"></div>
                                </div>
                                <div class="row">
                                    <div class="col-4">Date</div>
                                    <div class="col-1">:</div>
                                    <div class="col-7"></div>
