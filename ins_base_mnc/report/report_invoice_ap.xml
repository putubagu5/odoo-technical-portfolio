<odoo>
    <data>
        <template id="ins_base_mnc_report_invoice_ap_document_inherit"
                  inherit_id="account.report_invoice_document"
                  primary="True">
            <xpath expr="//h2" position="replace">
                <h2>
                    <span t-if="o.name != '/'" t-field="o.name"/><br/>
                    <span t-if="o.move_type == 'out_invoice' and o.state == 'posted'">Invoice</span>
                    <span t-if="o.move_type == 'out_invoice' and o.state == 'draft'">Draft Invoice</span>
                    <span t-if="o.move_type == 'out_invoice' and o.state == 'cancel'">Cancelled Invoice</span>
                    <span t-if="o.move_type == 'out_refund'">Credit Note</span>
                    <span t-if="o.move_type == 'in_refund'">Vendor Credit Note</span>
                    <span t-if="o.move_type == 'in_invoice'">Vendor Bill</span>
                </h2>
            </xpath>
            <xpath expr="//div[@id='informations']" position="replace">
                <div id="informations_one" class="row mt32 mb32">
                    <div class="col-auto mw-100 mb-2" name="invoice_date">
                        <strong>Date:</strong>
                        <p class="m-0" t-field="o.invoice_date"/>
                    </div>
                    <div t-if="o.invoice_date_due and o.state == 'posted'" class="col-auto mw-100 mb-2" name="due_date">
                        <strong>Due Date:</strong>
                        <p class="m-0" t-field="o.invoice_date_due"/>
                    </div>
                </div>
                <div id="informations_two" class="row mt32 mb32">
                    <div class="col-auto mw-100 mb-2" t-if="o.invoice_origin" name="origin">
                        <strong>Source:</strong>
                        <p class="m-0" t-field="o.invoice_origin"/>
                    </div>
                    <div class="col-auto mw-100 mb-2" t-if="o.ref" name="reference">
                        <strong>Reference:</strong>
                        <p class="m-0" t-field="o.ref"/>
                    </div>
                </div>
                <div id="informations_three" t-if="o.partner_id.ref" class="row mt32 mb32">
                    <div class="col-auto mw-100 mb-2" name="customer_code">
                        <strong>Customer Code:</strong>
                        <p class="m-0" t-field="o.partner_id.ref"/>
                    </div>
                </div>
            </xpath>
            <xpath expr="//div[@id='qrcode']" position="after">
                <!-- Custom signature -->
                <div class="row">
                    <div t-if="o.move_type == 'in_invoice'" class="col-4 text-center">
                        Purchasing
                    </div>
                    <div t-if="o.move_type == 'out_invoice'" class="col-4 text-center">
                        Sales Person
                    </div>
                    <div class="col-4 text-center">
                        Mengetahui
                    </div>
                    <div class="col-4 text-center">
                        Mengetahui
                    </div>
                </div>
                <div class="row">
                    <div class="col-4 text-center">
                        <br/><br/><br/><br/><br/>
                    </div>
                    <div class="col-4 text-center">
                        <br/><br/><br/><br/><br/>
                    </div>
                    <div class="col-4 text-center">
                        <span t-field="o.partner_id.name"/><br/><br/><br/><br/><br/>
                    </div>
                </div>
                <div class="row">
                    <div class="col-4 text-left">
                        Name:
                    </div>
                    <div class="col-4 text-left">
                        Name:
                    </div>
                    <div class="col-4 text-left">
                        Name:
                    </div>
                </div>
            </xpath>
        </template>

        <!-- INHERITED TEMPLATES FOR DIFFERENT PAPERFORMAT -->
        <template id="ins_base_mnc_report_invoice_ap_document_inherit_A4_portrait"
                  inherit_id="account.report_invoice_with_payments"
                  primary="True">
            <xpath expr="//t[@t-call='account.report_invoice_document']" position="replace">
                <t t-call="ins_base_mnc.ins_base_mnc_report_invoice_ap_document_inherit"/>
            </xpath>
        </template>
    </data>
</odoo>
