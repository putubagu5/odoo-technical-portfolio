<odoo>
    <template id="ins_base_mnc_report_rr_service_container">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="o">
                <t t-call="ins_base_mnc.ins_base_mnc_report_rr_service_document"/>
            </t>
        </t>
    </template>

    <template id="ins_base_mnc_report_rr_service_document">
        <t t-call="web.basic_layout">
            <div class="page" style="font-size: 12px !important;">
                <!-- logo -->
                <div class="header">
                    <div class="row">
                        <div class="col-12">
                            <table width="100%">
                                <tr>
                                    <td width="33%" align="center" style="border: 1px solid black">
                                        <img t-att-src="image_data_uri(o.company_id.logo)" alt="Logo" style="max-height: 100px; max-width: 120px;"/>
                                    </td>
                                    <td width="34%" align="center" style="border: 1px solid black; vertical-align: middle;">
                                        <strong>RECEIPT REPORT</strong>
                                    </td>
                                    <td width="33%" align="center" style="border: 1px solid black">
                                        &#160;
                                    </td>
                                </tr>
                            </table>
                        </div>
                    </div>
                </div>

                <!-- header, no and recipient -->
                <div class="row">
                    <div class="col-6">
                        <table>
                            <tr>
                                <td>
                                    Supplier
                                </td>
                                <td>
                                    &#160;:&#160;&#160;
                                </td>
                                <td>
                                    <span t-field="o.partner_id.name"/>
                                </td>
                            </tr>
                            <tr>
                                <td>
                                    Address
                                </td>
                                <td>
                                    &#160;:&#160;&#160;
                                </td>
                                <td>
                                    <span t-esc="o.sudo().partner_id.street"/>,&#160;<span t-esc="o.sudo().partner_id.city"/><br/>
                                    <span t-esc="o.sudo().partner_id.state_id.name"/>&#160;<span t-esc="o.sudo().partner_id.zip"/>,&#160;<span t-esc="o.sudo().partner_id.country_id.name"/><br/>
                                </td>
                            </tr>
                        </table>
                    </div>
                    <div class="col-6">
                        <table>
                            <tr>
                                <td>
                                    Receipt No
                                </td>
                                <td>
                                    &#160;:&#160;&#160;
                                </td>
                                <td>
                                    <span t-field="o.name"/>
                                </td>
                            </tr>
                            <tr>
                                <td>
                                    Receipt Date
                                </td>
                                <td>
                                    &#160;:&#160;&#160;
                                </td>
                                <t t-if="o.date_done">
                                    <td>
                                        <t t-esc="o.date_done.strftime('%d-%b-%y')"/>
                                    </td>
                                </t>
                            </tr>
                            <tr>
                                <td>
                                    Receipt By
                                </td>
                                <td>
                                    &#160;:&#160;&#160;
                                </td>
                                <td>
                                    <span t-esc="o.write_uid.name"/>
                                </td>
                            </tr>
                            <tr>
                                <td>
                                    Deliver Date
                                </td>
                                <td>
                                    &#160;:&#160;&#160;
                                </td>
                                <t t-if="o.date_done">
                                    <td>
                                        <t t-esc="o.date_done.strftime('%d-%b-%y')"/>
                                    </td>
                                </t>
                            </tr>
                        </table>
                    </div>
                </div>

                 <!-- table -->
                <div class="row">
                    <div class="col-12">
                        <table width="100%" style="border: 1px solid black;">
                            <tr>
                                <td class="text-center" style="border: 1px solid black; padding: 5px;">No</td>
                                <td class="text-center" style="border: 1px solid black; padding: 5px;">Item ID</td>
                                <td class="text-center" width="10%" style="border: 1px solid black; padding: 5px;">Description</td>
                                <td class="text-center" width="10%" style="border: 1px solid black; padding: 5px;">Referrence Document</td>
                                <td class="text-center" style="border: 1px solid black; padding: 5px;">Shipped Qty</td>
                                <td class="text-center" style="border: 1px solid black; padding: 5px;">Receipt Qty</td>
                                <td class="text-center" style="border: 1px solid black; padding: 5px;">UOM</td>
                                <td class="text-center" style="border: 1px solid black; padding: 5px;">Unit Price</td>
                                <td class="text-center" style="border: 1px solid black; padding: 5px;">Amount (Rp)</td>
                                <td class="text-center" style="border: 1px solid black; padding: 5px;">Charged Account</td>
                            </tr>
                            <tr t-foreach="o.move_ids_without_package" t-as="line">
                                <td class="text-center" style="border: 1px solid black; padding: 5px;"><t t-raw="line_index + 1"/></td>
                                <td class="text-center" style="border: 1px solid black; padding: 5px;"><t t-esc="line.product_id.default_code"/></td>
                                <td class="text-left" style="border: 1px solid black; padding: 5px;">
                                    <t t-esc="line.description_picking"/>
                                </td>
                                <td class="text-left" style="border: 1px solid black; padding: 5px;">
                                    PO : <t t-esc="line.purchase_line_id.order_id.name"/>,<br/>
                                    PR : <t t-if="line.purchase_request_allocation_ids">
                                            <t t-esc="line.purchase_request_allocation_ids[0].purchase_request_line_id.request_id.name"/>
                                         </t>,<br/>
                                    PO Date : <t t-esc="line.purchase_line_id.order_id.date_order.strftime('%d-%b-%y')"/>,<br/>
                                    PR Date : <t t-if="line.purchase_request_allocation_ids">
                                                 <t t-esc="line.purchase_request_allocation_ids[0].purchase_request_line_id.request_id.date_start.strftime('%d-%b-%y')"/>
                                              </t><br/>
                                    Buyer : <t t-esc="line.purchase_line_id.order_id.create_uid.name if line.purchase_line_id.order_id.create_uid else ''"/>
                                </td>
                                <td class="text-center" style="border: 1px solid black; padding: 5px;"><t t-esc="'{:,.0f}'.format(int(line.purchase_line_id.price_unit))"/></td>
                                <td class="text-center" style="border: 1px solid black; padding: 5px;"><t t-esc="'{:,.0f}'.format(int(line.purchase_line_id.price_unit))"/></td>
                                <td class="text-center" style="border: 1px solid black; padding: 5px;"><t t-esc="line.product_uom.name"/></td>
                                <td class="text-center" style="border: 1px solid black; padding: 5px;"><t t-esc="line.quantity_done" t-options='{"widget": "float", "precision": 2}'/></td>
                                <td class="text-center" style="border: 1px solid black; padding: 5px;"><t t-esc="'{:,.0f}'.format(int(line.purchase_line_id.price_unit * line.purchase_line_id.order_id.actual_rate * line.quantity_done))"/></td>
                                <td class="text-left" style="border: 1px solid black; padding: 5px;"><t t-esc="line.purchase_line_id.account_id.code"/> - <t t-esc="line.purchase_line_id.account_id.name"/></td>
                            </tr>
                            <tr style="border-top: 1px solid black;">
                                <td class="text-right" colspan="8" style="border: 1px solid black; padding: 5px;"><strong>Total</strong></td>
                                <!-- <td class="text-center" style="border: 1px solid black; padding: 5px;"><strong><t t-esc="'{0:,.0f}'.format(int(sum(line.quantity_done for line in o.move_ids_without_package)))"/></strong></td> -->
                                <td class="text-center" style="border: 1px solid black; padding: 5px;"><strong><t t-esc="'{0:,.0f}'.format(int(sum(line.purchase_line_id.price_unit * line.purchase_line_id.order_id.actual_rate * line.quantity_done for line in o.move_ids_without_package)))"/></strong></td>
                                <td class="text-right" style="border: 1px solid black; padding: 5px;">&#160;</td>
                            </tr>
                        </table>
                    </div>
                </div>

            </div>
        </t>
    </template>
</odoo>
