<odoo>
    <data>
        <record id="view_all_ap_invoices_report_form" model="ir.ui.view">
            <field name="name">view.all.ap.invoices.report.form</field>
            <field name="model">wizard.all.ap.invoices.report</field>
            <field name="arch" type="xml">
                <form>
                    <group>
                        <group>
                            <field name="date" required="1"/>
                        </group>
                    </group>
                    <footer>
                        <button name="print_report" string="Print" type="object" class="btn-primary"/>
                        <button string="Cancel" class="btn-default" special="cancel"/>
                    </footer>
                </form>
            </field>
        </record>

        <record id="action_wizard_all_ap_invoices_report" model="ir.actions.act_window">
            <field name="name">All AP Invoices Report</field>
            <field name="res_model">wizard.all.ap.invoices.report</field>
            <field name="view_mode">form</field>
            <field name="target">new</field>
        </record>

        <menuitem
            id="menu_wizard_all_ap_invoices_report"
            name="All AP Invoices Report"
            action="action_wizard_all_ap_invoices_report"
            parent="account.menu_finance_payables"
            sequence="202"/>
    </data>
</odoo>
