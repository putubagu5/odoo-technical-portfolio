<odoo>
    <data>
        <record id="ins_stock_card_view_stock_card_form" model="ir.ui.view">
            <field name="name">ins.stock.card.view.stock.card.form</field>
            <field name="model">stock.card</field>
            <field name="arch" type="xml">
                <form>
                    <header>
                        <button name="button_open" type="object" class="oe_highlight"
                                states="draft" string="Open"/>
                        <button name="button_calculate" type="object" class="oe_highlight"
                                states="draft" string="Calculate"/>
                        <button name="button_done" type="object" class="oe_highlight"
                                states="open" string="Done"/>
                        <field name="state" widget="statusbar"/>
                    </header>
                    <sheet>
                        <div class="oe_title">
                            <label for="name" class="oe_edit_only"/>
                            <h1>
                                <field name="name" required="1"/>
                            </h1>
                        </div>
                        <group>
                            <group>
                                <field name="product_id" required="1"/>
                                <field name="location_id" required="1"/>
                            </group>
                            <group>
                                <field name="date_start" required="1"/>
                                <field name="date_end" required="1"/>
                                <field name="user_id"/>
                            </group>
                        </group>
                        <notebook>
                            <page string="Details">
                                <field name="line_ids" nolabel="1">
                                    <tree>
                                        <field name="date"/>
                                        <field name="picking_id"/>
                                        <field name="name"/>
                                        <field name="qty_start"/>
                                        <field name="qty_in"/>
                                        <field name="qty_out"/>
                                        <field name="qty_balance"/>
                                        <field name="product_uom_id"/>
                                        <field name="price"/>
                                        <field name="value"/>
                                    </tree>
                                </field>
                            </page>
                        </notebook>
                    </sheet>
                </form>
            </field>
        </record>

        <record id="ins_stock_card_view_stock_card_tree" model="ir.ui.view">
            <field name="name">ins.stock.card.view.stock.card.tree</field>
            <field name="model">stock.card</field>
            <field name="arch" type="xml">
                <tree>
                    <field name="name"/>
                    <field name="date_start"/>
                    <field name="date_end"/>
                    <field name="location_id"/>
                    <field name="product_id"/>
                    <field name="user_id"/>
                    <field name="state"/>
                </tree>
            </field>
        </record>

        <record id="action_view_stock_card_form" model="ir.actions.act_window">
            <field name="name">Stock Card</field>
            <field name="res_model">stock.card</field>
            <field name="view_mode">tree,form</field>
        </record>

        <menuitem
            id="menu_stock_card"
            action="action_view_stock_card_form"
            parent="stock.menu_warehouse_report"/>
    </data>
</odoo>
