<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record id="inv_prepayment_paid_supplier_report_wizard_form_view" model="ir.ui.view">
            <field name="name">invoice.prepayment.paid.supplier.wizard.form.view</field>
            <field name="model">invoice.prepayment.paid.supplier.wizard</field>
            <field name="inherit_id" ref="mnc_xlsx_reporting.and_report_wizard_form_view"/>
            <field name="mode">primary</field>
            <field name="priority">1</field>
            <field name="arch" type="xml">
                <xpath expr="//sheet[1]" position="inside">
                    <group>
                        <field name="account_type" required="1"/>
                        <field name="account_ids" widget="many2many_tags" attrs="{'required': [('account_type', '=', 'specific')], 'invisible': [('account_type', '!=', 'specific')]}" options="{'no_create': True, 'no_create_edit': True, 'no_edit': True}"/>
                    </group>
                    <group>
                        <field name="prepayment_state"/>
                    </group>
                </xpath>
            </field>
        </record>
    </data>
</odoo>
