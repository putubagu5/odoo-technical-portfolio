<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record id="ar_unapplied_receipt_report_wizard_form_view" model="ir.ui.view">
            <field name="name">ar.unapplied.receipt.report.wizard.form.view</field>
            <field name="model">ar.unapplied.receipt.report.wizard</field>
            <field name="inherit_id" ref="mnc_xlsx_reporting.and_report_wizard_form_view"/>
            <field name="mode">primary</field>
            <field name="priority">1</field>
            <field name="arch" type="xml">
                <xpath expr="//sheet[1]" position="inside">
                    <group>
                        <field name="current_user_companies" invisible="1" widget="many2many_tags"/>
                        <field name="company_ids" widget="many2many_tags"
                               domain="[('id', 'in', current_user_companies)]"
                               options="{'no_create': True, 'no_create_edit': True, 'no_edit': True}"/>
                    </group>
                </xpath>
            </field>
        </record>
    </data>
</odoo>
