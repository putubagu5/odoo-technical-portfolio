<odoo>
    <data>
        <record id="action_wizard_tax_invoice_in" model="ir.actions.act_window">
            <field name="name">Export Faktur Pajak Masukan</field>
            <field name="res_model">wizard.tax.invoice.in</field>
            <field name="view_mode">form</field>
            <field name="target">new</field>
        </record>

        <record id="view_wizard_tax_invoice_in_form" model="ir.ui.view">
            <field name="name">view.wizard.tax.invoice.in.form</field>
            <field name="model">wizard.tax.invoice.in</field>
            <field name="arch" type="xml">
                <form string="Export Pajak Masukan">
                    <footer>
                        <button string="Export" name="button_print" type="object" class="btn-primary"/>
                        <button string="Cancel" class="btn-default" special="cancel" />
                    </footer>
                </form>
            </field>
        </record>

        <menuitem
            id="menu_tax_invoice_in_export"
            name="Export FP. Masukan"
            action="action_wizard_tax_invoice_in"
            parent="ins_tax_invoice.menu_tax_invoice_export"
            sequence="61"/>
    </data>
</odoo>
