<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>

        <record id="purchase_request_line_make_purchase_agreement_form_view" model="ir.ui.view">
            <field name="name">pr.line.make.pa.form.view</field>
            <field name="model">purchase.request.line.make.purchase.agreement</field>
            <field name="type">form</field>
            <field name="arch" type="xml">
                <form>
                    <!--<group>
                        <group>
                            <field name="requested_by"/>
                        </group>
                    </group>
                    -->
                    <field name="requested_by" invisible="1" force_save="1"/>
                    <p>Are you sure want to Create Purchase Agreement with the following products?</p>
                    <label for="item_ids"/>
                    <field name="item_ids" nolabel="1">
                        <tree create="0" delete="0" edit="0">
                            <field name="line_id" invisible="1"/>
                            <field name="product_id"/>
                            <field name="name"/>
                            <field name="product_qty"/>
                            <field name="product_uom_id"/>
                        </tree>
                    </field>
                    <footer>
                        <button
                            name="make_purchase_agreement"
                            string="Create Purchase Agreement"
                            type="object"
                            class="oe_highlight"
                        />
                        <button special="cancel" string="Cancel" class="oe_link"/>
                    </footer>
                </form>
            </field>
        </record>

        <record id="action_purchase_request_line_make_purchase_agreement" model="ir.actions.act_window">
            <field name="name">Create Purchase Agreement</field>
            <field name="type">ir.actions.act_window</field>
            <field name="res_model">purchase.request.line.make.purchase.agreement</field>
            <field name="view_mode">form</field>
            <field name="view_id" ref="purchase_request_line_make_purchase_agreement_form_view"/>
            <field name="target">new</field>
            <field
                name="binding_model_id"
                ref="purchase_request.model_purchase_request_line"
            />
        </record>

    </data>
</odoo>