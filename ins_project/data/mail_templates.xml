<odoo>
    <data>
        <record id="budget_mail_template" model="mail.template">
            <field name="name">Budget</field>
            <field name="model_id" ref="ins_project.model_pmis_budget"/>
            <field name="email_from">${ctx['email_from']}</field>
            <field name="email_to">${ctx['email_to']}</field>
            <field name="email_cc">${ctx['email_cc']}</field>
            <field name="subject">${ctx['mail_subject']}</field>
            <field name="body_html" type="html">
                <div>
                    <div class="row">
                        <div class="col-3">From</div>
                        <div class="col-3"></div>
                        <div class="col-3">Program ID/Code</div>
                        <div class="col-3">
                            <strong>${object.program_id.id} / ${object.program_id.code}</strong>
                        </div>
                    </div>
                    <div class="row">
                        <div class="col-3">To</div>
                        <div class="col-3"></div>
                        <div class="col-3">Phase ID/Name</div>
                        <div class="col-3">
                            <strong>${object.task_id.id} / ${object.task_id.code}</strong>
                        </div>
                    </div>
                    <div class="row">
                        <div class="col-3">Sent</div>
                        <div class="col-3">
                            <strong>${ctx['date_sent']}</strong>
                        </div>
                        <div class="col-3">Total Budget</div>
                        <div class="col-3">
                            <strong>${ctx['amount_budget']}</strong>
                        </div>
                    </div>
                    <div class="row">
                        <div class="col-3">Log Id</div>
                        <div class="col-3"></div>
                        <div class="col-3">Description</div>
                        <div class="col-3">
                            <strong>${object.task_id.name}</strong>
                        </div>
                    </div>
                </div>

                <div style="margin: 5px 0px;">
                    <strong>Historical Log</strong>
                    <br/>
                    <table class="table table-sm table-bordered">
                        <tr>
                            <td>Seq</td>
                            <td>By Who</td>
                            <td>To</td>
                            <td>Date</td>
                            <td>Action</td>
                            <td>Status</td>
                            <td>Note</td>
                        </tr>
                    </table>
                </div>

                <div style="margin: 5px 0px;">
                    Thus we convey this information<br/>
                    Sincerely,
                    <br/>
                    <br/>
                    <br/>
                    PMIS Administrator
                    <br/>
                    <br/>
                    Note: this email is automatically generated by the system, please do not reply.
                </div>
            </field>
            <field name="report_template" ref="ins_project.report_budget_program"/>
        </record>
    </data>
</odoo>
