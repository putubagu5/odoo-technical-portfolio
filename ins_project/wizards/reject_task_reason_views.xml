<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>

        <record id="wizard_reject_task_reason_form_view" model="ir.ui.view">
            <field name="name">wizard.reject.task.reason.form.view</field>
            <field name="model">wizard.reject.task.reason</field>
            <field name="arch" type="xml">
                <form>
                    <sheet>
                        <group>
                            <field name="task_id" invisible="1"/>
                            <field name="reason"/>
                        </group>
                    </sheet>
                    <footer>
                        <button name="submit" string="Submit" type="object" class="oe_highlight"/>
                        <button special="cancel" string="Cancel" class="oe_link" />
                    </footer>
                </form>
            </field>
        </record>

    </data>
</odoo>