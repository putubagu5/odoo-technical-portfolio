<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>

        <record id="search_b_line_wizard_form_view" model="ir.ui.view">
            <field name="name">search.b.line.wizard.form.view</field>
            <field name="model">pmis.search.budget.lines</field>
            <field name="arch" type="xml">
                <form>
                    <sheet>
                        <group>
                            <group>
                                <field name="expenditure_category_ids" required="1" widget="many2many_tags"/>
                                <field name="expenditure_subcategory_ids" required="1" widget="many2many_tags"/>
                                <field name="expenditure_type_ids" required="1" widget="many2many_tags"/>
                                <field name="budget_id" invisible="True"/>
                            </group>
                        </group>
                        <notebook>
                            <page string="Result">
                                <field name="budget_line_ids" readonly="1" nolabel="1">
                                    <tree string="Budget Lines" edit="0" create="0" delete="0">
                                        <field name="expenditure_type_id"/>
                                        <field name="item_code"/>
                                        <field name="item_name"/>
                                        <field name="description"/>
                                        <field name="budget"/>
                                        <field name="remarks"/>
                                        <field name="company_id" invisible="1"/>
                                    </tree>
                                </field>
                                <group class="oe_subtotal_footer oe_right">
                                    <div class="oe_subtotal_footer_separator oe_inline">
                                        <label for="total_budget"/>
                                    </div>
                                    <field
                                        name="total_budget"
                                        nolabel="1"
                                        class="oe_subtotal_footer_separator"
                                    />
                                </group>
                            </page>
                        </notebook>
                    </sheet>
                    <footer>
<!--                        <button name="submit" string="Submit" type="object" class="oe_highlight"/>-->
                        <button special="cancel" string="Close" class="oe_link"/>
                    </footer>
                </form>
            </field>
        </record>

    </data>
</odoo>