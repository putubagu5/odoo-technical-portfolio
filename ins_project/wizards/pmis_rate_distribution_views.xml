<odoo>
    <data>
        <record id="view_wizard_pmis_rate_distribution" model="ir.ui.view">
            <field name="name">view.wizard.pmis.rate.distribution</field>
            <field name="model">wizard.pmis.rate.distribution</field>
            <field name="arch" type="xml">
                <form>
                    <footer>
                        <button name="button_distribute" type="object" class="btn-primary" string="Process"/>
                        <button class="btn-secondary" string="Cancel" special="cancel"/>
                    </footer>
                </form>
            </field>
        </record>

        <record id="action_wizard_pmis_rate_distribution" model="ir.actions.act_window">
            <field name="name">Distribute Rate</field>
            <field name="res_model">wizard.pmis.rate.distribution</field>
            <field name="view_mode">tree,form</field>
            <field name="view_id" ref="view_wizard_pmis_rate_distribution"/>
            <field name="target">new</field>
            <field name="binding_model_id" ref="ins_project.model_pmis_budget"/>
            <field name="binding_view_types">list</field>
        </record>
    </data>
</odoo>
