<odoo>
    <data>
        <record id="view_project_genre_form" model="ir.ui.view">
            <field name="name">view.project.genre.form</field>
            <field name="model">project.genre</field>
            <field name="arch" type="xml">
                <form>
                    <sheet>
                        <group>
                            <group>
                                <field name="category_id" required="1"/>
                                <field name="name" required="1"/>
                                <field name="code" required="1"/>
                                <field name="date_start" required="1"/>
                                <field name="date_end"/>
                                <field name="company_id" readonly="1"/>
                                <field name="note"/>
                            </group>
                        </group>
                    </sheet>
                </form>
            </field>
        </record>

        <record id="view_project_genre_tree" model="ir.ui.view">
            <field name="name">view.project.genre.tree</field>
            <field name="model">project.genre</field>
            <field name="arch" type="xml">
                <tree>
                    <field name="category_id"/>
                    <field name="name"/>
                    <field name="code"/>
                    <field name="date_start"/>
                    <field name="date_end"/>
                    <field name="note"/>
                </tree>
            </field>
        </record>

        <record id="action_view_project_genre" model="ir.actions.act_window">
            <field name="name">Project Genre</field>
            <field name="res_model">project.genre</field>
            <field name="view_mode">tree,form</field>
        </record>

        <menuitem
            id="menu_pmis"
            name="PMIS"
            groups="project.group_project_manager"
            sequence="33"/>

        <menuitem id="menu_pmis_config"
            name="Configurations"
            parent="menu_pmis"
            sequence="2"/>

        <menuitem
            id="menu_project_genre"
            name="Project Genre"
            action="action_view_project_genre"
            groups="project.group_project_manager"
            parent="ins_project.menu_pmis_config"
            sequence="6"/>
    </data>
</odoo>
