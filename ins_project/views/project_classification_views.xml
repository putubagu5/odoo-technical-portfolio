<odoo>
    <data>
        <record id="view_project_classification_form" model="ir.ui.view">
            <field name="name">view.project.classification.form</field>
            <field name="model">project.classification</field>
            <field name="arch" type="xml">
                <form>
                    <sheet>
                        <group>
                            <group>
                                <field name="name" required="1"/>
                                <field name="code" required="1"/>
                                <field name="note"/>
                                <field name="company_id" readonly="1"/>
                            </group>
                        </group>
                    </sheet>
                </form>
            </field>
        </record>

        <record id="view_project_classification_tree" model="ir.ui.view">
            <field name="name">view.project.classification.tree</field>
            <field name="model">project.classification</field>
            <field name="arch" type="xml">
                <tree>
                    <field name="name"/>
                    <field name="code"/>
                    <field name="note"/>
                    <field name="company_id"/>
                </tree>
            </field>
        </record>

        <record id="view_project_classification_search" model="ir.ui.view">
            <field name="name">view.project.classification.search</field>
            <field name="model">project.classification</field>
            <field name="arch" type="xml">
                <search>
                    <field name="code" string="Project Code"/>
                    <field name="name" string="Project Name"/>
                </search>
            </field>
        </record>

        <record id="action_view_project_classification" model="ir.actions.act_window">
            <field name="name">Project Classification</field>
            <field name="res_model">project.classification</field>
            <field name="view_mode">tree,form</field>
        </record>

        <!-- <menuitem
            id="menu_project_classification"
            name="Project Classification"
            action="action_view_project_classification"
            groups="project.group_project_manager"
            parent="project.menu_project_config"
            sequence="20"/> -->

        <menuitem
            id="menu_pmis"
            name="PMIS"
            groups="project.group_project_manager"
            sequence="33"/>

        <menuitem id="menu_pmis_project"
            name="Project"
            parent="menu_pmis"
            sequence="0"/>

        <menuitem
            id="menu_pmis_project_classification"
            name="Project Classification"
            action="action_view_project_classification"
            groups="project.group_project_manager"
            parent="ins_project.menu_pmis_config"
            sequence="0"/>
    </data>
</odoo>
