<odoo>
    <data>
        <record id="view_pmis_departement_type_form" model="ir.ui.view">
            <field name="name">view.pmis.departement.type.form</field>
            <field name="model">pmis.departement.type</field>
            <field name="arch" type="xml">
                <form>
                    <sheet>
                        <group>
                            <group>
                                <field name="name" required="1"/>
                                <field name="analytic_account_id" required="1"/>
                                <field name="company_id" readonly="1"/>
                            </group>
                        </group>
                    </sheet>
                </form>
            </field>
        </record>

        <record id="view_pmis_departement_type_tree" model="ir.ui.view">
            <field name="name">view.pmis.departement.type.tree</field>
            <field name="model">pmis.departement.type</field>
            <field name="arch" type="xml">
                <tree>
                    <field name="name" required="1"/>
                    <field name="analytic_account_id" required="1"/>
                    <field name="company_id" readonly="1"/>
                </tree>
            </field>
        </record>

        <record id="action_view_pmis_departement_type" model="ir.actions.act_window">
            <field name="name">Departement Type</field>
            <field name="res_model">pmis.departement.type</field>
            <field name="view_mode">tree,form</field>
        </record>

        <menuitem
            id="menu_pmis"
            name="PMIS"
            groups="project.group_project_manager"
            sequence="33"/>

        <menuitem id="menu_pmis_config"
            name="Configurations"
            parent="menu_pmis"
            sequence="2"/>

        <menuitem
            id="menu_pmis_departement_type"
            name="Departement Type"
            action="action_view_pmis_departement_type"
            groups="project.group_project_manager"
            parent="ins_project.menu_pmis_config"
            sequence="11"/>
    </data>
</odoo>
