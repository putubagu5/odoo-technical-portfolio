<odoo>
    <data>
        <record id="view_pmis_assignee_form" model="ir.ui.view">
            <field name="name">view.pmis.assignee.form</field>
            <field name="model">pmis.assignee</field>
            <field name="arch" type="xml">
                <form>
                    <sheet>
                        <group>
                            <group>
                                <field name="name" required="1"/>
                                <field name="report_id" domain="[('model', '=', model)]" required="1"/>
                                <field name="model" invisible="1"/>
                                <field name="company_line_id" required="1"/>
                            </group>
                        </group>
                        <notebook>
                            <page name="signatures" string="Signatures">
                                <field name="sign_ids" nolabel="1">
                                    <tree editable="bottom">
                                        <field name="sequence" widget="handle"/>
                                        <field name="seq" required="1"/>
                                        <field name="emp_position" required="1"/>
                                        <field name="emp_name" required="1"/>
                                        <field name="analytic_account_id" required="1"/>
                                        <field name="department_type_id"/>
                                    </tree>
                                </field>
                            </page>
                        </notebook>
                    </sheet>
                </form>
            </field>
        </record>

        <record id="view_pmis_assignee_tree" model="ir.ui.view">
            <field name="name">view.pmis.assignee.tree</field>
            <field name="model">pmis.assignee</field>
            <field name="arch" type="xml">
                <tree>
                    <field name="name"/>
                    <field name="report_id"/>
                    <field name="model"/>
                    <field name="company_line_id"/>
                </tree>
            </field>
        </record>

        <record id="action_view_pmis_assignee" model="ir.actions.act_window">
            <field name="name">PMIS Assignee</field>
            <field name="res_model">pmis.assignee</field>
            <field name="view_mode">tree,form</field>
        </record>

        <menuitem
            id="menu_pmis"
            name="PMIS"
            groups="project.group_project_manager"
            sequence="33"/>

        <menuitem id="menu_pmis_config"
            name="Configurations"
            parent="menu_pmis"
            sequence="2"/>

        <menuitem
            id="menu_pmis_assignee"
            name="PMIS Assignee"
            action="action_view_pmis_assignee"
            groups="project.group_project_manager"
            parent="ins_project.menu_pmis_config"
            sequence="10"/>
    </data>
</odoo>
