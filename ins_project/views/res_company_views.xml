<odoo>
    <data>
        <record id="view_inherit_res_company_form" model="ir.ui.view">
            <field name="name">view.inherit.res.company.form</field>
            <field name="model">res.company</field>
            <field name="inherit_id" ref="base.view_company_form"/>
            <field name="arch" type="xml">
                <!-- add company_code after h1 -->
                <xpath expr="//h1" position="after">
                    <h3>
                        <label for="company_code"/>
                        <field name="company_code"/>
                    </h3>
                </xpath>
                <xpath expr="//notebook" position="inside">
                    <page name="pmis_page" string="PMIS">
                        <group>
                            <group string="Budget Type Control" name="group_pmis">
                                <field name="default_budget_type_project"/>
                                <field name="default_budget_type_task"/>
                                <field name="default_budget_type_subtask"/>
                                <field name="default_budget_type_category"/>
                                <field name="default_budget_type_subcategory"/>
                            </group>
                            <group name="task_status">
                                <field name="status_task"/>
                            </group>
                        </group>
                    </page>
                    <page name="assignee_page" string="Print Budget">
                        <group>
                            <group name="group_assignee">
                                <field name="signature_id"/>
                                <!-- <field name="assignee_ids">
                                    <tree editable="bottom">
                                        <field name="name"/>
                                        <field name="company_line_id" invisible="1"/>
                                    </tree>
                                </field> -->
                            </group>
                        </group>
                    </page>
                </xpath>
            </field>
        </record>
    </data>
</odoo>
