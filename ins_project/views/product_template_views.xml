<odoo>
    <data>
      <record id="inherit_product_template_form" model="ir.ui.view">
            <field name="name">inherit.product.template.form</field>
            <field name="model">product.template</field>
            <field name="inherit_id" ref="product.product_template_form_view"/>
            <field name="arch" type="xml">
                <xpath expr="//notebook" position="inside">
                    <page name="expenditure_type" string="Expenditure Type">
                        <group>
                            <group name="group_expenditure">
                                <field name="expenditure_type_id" string="Expenditure Type"/>
                            </group>
                        </group>
                    </page>
                    <page name="group_type" string="Group Type">
                        <group>
                            <group name="group_grouptype">
                                <field name="group_type_id" string="Group Type"/>
                            </group>
                        </group>
                    </page>
                    <page name="analytic_acc" string="Analytic Account">
                        <group>
                            <group name="group_analytic_account">
                                <field name="analytic_account_id" string="Analytic Account"/>
                            </group>
                        </group>
                    </page>
                </xpath>
            </field>
      </record>
    </data>
</odoo>