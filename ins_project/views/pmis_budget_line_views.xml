<odoo>
    <data>
        <record id="view_pmis_budget_line_form" model="ir.ui.view">
            <field name="name">view.pmis.budget.line.form</field>
            <field name="model">pmis.budget.line</field>
            <field name="arch" type="xml">
                <form>
                    <sheet>
                        <group>
                            <group>
                                <field name="main_project_id" readonly="1"/>
                                <field name="program_id" readonly="1"/>
                                <field name="task_id" readonly="1"/>
                                <field name="expenditure_type_id" readonly="1"/>
                                <field name="subcategory_id" readonly="1"/>
                                <field name="category_id" readonly="1"/>
                                <field name="item_code" readonly="1"/>
                                <field name="item_name" readonly="1"/>
                                <field name="description" readonly="1"/>
                                <field name="pax" readonly="1"/>
                                <field name="eps" readonly="1"/>
                                <field name="day" readonly="1"/>
                                <field name="rate" readonly="1"/>
                                <field name="average_by_eps" readonly="1"/>
                                <field name="budget" readonly="1"/>
                                <field name="amount_budget_in" readonly="1"/>
                                <field name="amount_budget_out" readonly="1"/>
                                <field name="amount_budget_line" readonly="1"/>
                                <field name="actual_budget" readonly="1"/>
                                <field name="pr_reserve_amount" readonly="1"/>
                                <field name="pr_reserve_draft_amount" readonly="1"/>
                                <field name="po_reserve_amount" readonly="1"/>
                                <field name="remaining_amount" decoration-danger="remaining_amount &lt; 0" readonly="1"/>
                                <field name="remaining_draft_amount" decoration-danger="remaining_draft_amount &lt; 0" readonly="1"/>
                                <field name="remarks" readonly="1"/>
                                <field name="detail_ids" readonly="1"/>
                                <field name="company_id" readonly="1"/>
                                <!-- <field name="project_pr_line_ids" readonly="1"/> -->
                                <!-- <field name="pr_numbers" readonly="1"/>
                                <field name="po_numbers" readonly="1"/>
                                <field name="rr_numbers" readonly="1"/> -->
                            </group>
                        </group>
                        <notebook>
                            <page name="project_lines" string="Project PR Lines">
                                <field name="project_pr_line_ids" nolabel="1" readonly="1"/>
                            </page>
                        </notebook>
                    </sheet>
                </form>
            </field>
        </record>

        <record id="view_pmis_budget_line_tree" model="ir.ui.view">
            <field name="name">view.pmis.budget.line.tree</field>
            <field name="model">pmis.budget.line</field>
            <field name="arch" type="xml">
                <tree create="false" decoration-danger="remaining_amount &lt; 0 or remaining_draft_amount &lt; 0">
                    <field name="main_project_id"/>
                    <field name="program_id"/>
                    <field name="task_id"/>
                    <field name="expenditure_type_id"/>
                    <field name="subcategory_id"/>
                    <field name="category_id"/>
                    <field name="item_code"/>
                    <field name="item_name"/>
                    <field name="description"/>
                    <field name="pax"/>
                    <field name="eps"/>
                    <field name="day"/>
                    <field name="rate"/>
                    <field name="average_by_eps"/>
                    <field name="budget"/>
                    <field name="amount_budget_in"/>
                    <field name="amount_budget_out"/>
                    <field name="amount_budget_line"/>
                    <field name="actual_budget"/>
                    <field name="pr_reserve_amount"/>
                    <field name="pr_reserve_draft_amount"/>
                    <field name="po_reserve_amount"/>
                    <field name="remaining_amount" decoration-danger="remaining_amount &lt; 0"/>
                    <field name="remaining_draft_amount" decoration-danger="remaining_draft_amount &lt; 0"/>
                    <field name="remarks"/>
                    <field name="detail_ids"/>
                    <field name="company_id"/>
                    <field name="project_pr_line_ids"/>
                </tree>
            </field>
        </record>

        <record id="view_pmis_budget_line_search" model="ir.ui.view">
            <field name="name">view.pmis.budget.line.search</field>
            <field name="model">pmis.budget.line</field>
            <field name="arch" type="xml">
                <search>
                    <field name="item_code" string="Program Code"/>
                    <field name="main_project_id" string="Main Project ID"/>
                    <field name="program_id" string="Program"/>
                    <field name="task_id" string="Task"/>
                </search>
            </field>
        </record>

        <record id="action_view_pmis_budget_line" model="ir.actions.act_window">
            <field name="name">Budget Detail (Line)</field>
            <field name="res_model">pmis.budget.line</field>
            <field name="view_mode">tree,form</field>
        </record>

        <!-- <menuitem
            id="menu_pmis"
            name="PMIS"
            groups="project.group_project_manager"
            sequence="33"/>

        <menuitem id="menu_pmis_config"
            name="Configurations"
            parent="menu_pmis"
            sequence="2"/> -->

        <menuitem
            id="menu_pmis_budget_line"
            name="Budget Detail (Line)"
            action="action_view_pmis_budget_line"
            groups="project.group_project_manager"
            parent="ins_project.menu_pmis_budget"
            sequence="9"/>
    </data>
</odoo>
