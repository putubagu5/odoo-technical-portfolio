<odoo>
    <data>
        <record id="view_project_expenditure_type_form" model="ir.ui.view">
            <field name="name">view.project.expenditure.type.form</field>
            <field name="model">project.expenditure.type</field>
            <field name="arch" type="xml">
                <form>
                    <sheet>
                        <group>
                            <group>
                                <field name="name" string="Expenditure Type Name" required="1"/>
                                <field name="code" string="Expenditure Type Code" required="1"/>
                                <field name="analytic_account_id" required="1"/>
                                <field name="group_id" required="1"/>
                                <field name="category_id" required="1"/>
                                <field name="date_start" required="1"/>
                                <field name="date_end"/>
                                <field name="company_id"  readonly="1"/>
                                <field name="note"/>
                            </group>
                        </group>
                    </sheet>
                </form>
            </field>
        </record>

        <record id="view_project_expenditure_type_tree" model="ir.ui.view">
            <field name="name">view.project.expenditure.type.tree</field>
            <field name="model">project.expenditure.type</field>
            <field name="arch" type="xml">
                <tree>
                    <field name="category_id"/>
                    <field name="name" string="Expenditure Type Name"/>
                    <field name="code" string="Expenditure Type Code"/>
                    <field name="date_start"/>
                    <field name="date_end"/>
                    <field name="company_id" readonly="1"/>
                    <field name="note"/>
                </tree>
            </field>
        </record>

        <record id="view_project_expenditure_search" model="ir.ui.view">
            <field name="name">view.project.expenditure.search</field>
            <field name="model">project.expenditure.type</field>
            <field name="arch" type="xml">
                <search>
                    <field name="category_id" string="Category"/>
                    <field name="name" string="Name"/>
                    <field name="code" string="Code"/>
                </search>
            </field>
        </record>

        <record id="action_view_project_expenditure_type" model="ir.actions.act_window">
            <field name="name">Project Expenditure Type</field>
            <field name="res_model">project.expenditure.type</field>
            <field name="view_mode">tree,form</field>
        </record>

        <menuitem
            id="menu_pmis"
            name="PMIS"
            groups="project.group_project_manager"
            sequence="33"/>

        <menuitem id="menu_pmis_config"
            name="Configurations"
            parent="menu_pmis"
            sequence="2"/>

        <menuitem
            id="menu_project_expenditure_type"
            name="Project Expenditure Type"
            action="action_view_project_expenditure_type"
            groups="project.group_project_manager"
            parent="ins_project.menu_pmis_config"
            sequence="1"/>
    </data>
</odoo>
