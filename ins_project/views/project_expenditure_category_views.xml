<odoo>
    <data>
        <record id="view_project_expenditure_category_form" model="ir.ui.view">
            <field name="name">view.project.expenditure.category.form</field>
            <field name="model">project.expenditure.category</field>
            <field name="arch" type="xml">
                <form>
                    <sheet>
                        <group>
                            <group>
                                <field name="name" required="1"/>
                                <field name="code" required="1"/>
                                <field name="analytic_account_id" required="1"/>
                                <field name="group_id" required="1"/>
                                <field name="date_start" required="1"/>
                                <field name="date_end"/>
                                <field name="company_id"/>
                                <field name="note"/>
                                <field name="budget_type" required="1"/>
                            </group>
                        </group>
                    </sheet>
                </form>
            </field>
        </record>

        <record id="view_project_expenditure_category_tree" model="ir.ui.view">
            <field name="name">view.project.expenditure.category.tree</field>
            <field name="model">project.expenditure.category</field>
            <field name="arch" type="xml">
                <tree>
                    <field name="name"/>
                    <field name="code"/>
                    <field name="group_id"/>
                    <field name="date_start"/>
                    <field name="date_end"/>
                    <field name="company_id"/>
                    <field name="analytic_account_id"/>
                    <field name="note"/>
                    <field name="budget_type"/>
                </tree>
            </field>
        </record>

        <record id="action_view_project_expenditure_category" model="ir.actions.act_window">
            <field name="name">Project Expenditure Category</field>
            <field name="res_model">project.expenditure.category</field>
            <field name="view_mode">tree,form</field>
        </record>

        <menuitem
            id="menu_pmis"
            name="PMIS"
            groups="project.group_project_manager"
            sequence="33"/>

        <menuitem id="menu_pmis_config"
            name="Configurations"
            parent="menu_pmis"
            sequence="2"/>

        <menuitem
            id="menu_project_expenditure_category"
            name="Project Expenditure"
            groups="project.group_project_manager"
            parent="ins_project.menu_pmis_config"
            sequence="0"/>

        <menuitem
            id="menu_project_expenditure_category_first"
            name="Project Expenditure Category"
            action="action_view_project_expenditure_category"
            groups="project.group_project_manager"
            parent="ins_project.menu_project_expenditure_category"
            sequence="0"/>
    </data>
</odoo>
