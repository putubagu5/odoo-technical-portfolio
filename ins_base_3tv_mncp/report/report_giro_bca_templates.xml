<odoo>
    <template id="report_payment_giro_bca_container">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="o">
                <t t-call="ins_base_3tv_mncp.report_payment_giro_bca_document"/>
            </t>
        </t>
    </template>

    <template id="ins_base_3tv_mncp.report_payment_giro_bca_document">
        <t t-call="web.basic_layout">
            <div class="page" style="font-size: 14px !important;">
                <div class="row">
                    <div class="col-12">
                        <table width="100%">
                            <tr>
                                <td width="60%" height="30px"/>
                                <td width="40%" style="vertical-align: middle;">
                                    <span>Jakarta,
                                        <t t-esc="o.date_paid.strftime('%d/%b/%Y') if o.date_paid else ''"/>
                                    </span>
                                </td>
                            </tr>
                        </table>
                        <table width="100%">
                            <tr>
                                <td width="30%"/>
                                <td width="70%" height="27px" style="vertical-align: bottom;">
                                    <span t-field="o.acc_name"/>
                                </td>
                            </tr>
                        </table>
                        <table width="100%">
                            <tr>
                                <td width="28%"/>
                                <td width="72%" height="33px" style="vertical-align: bottom">
                                    <span t-field="o.words1"/>
                                </td>
                            </tr>
                        </table>
                        <table width="100%">
                            <tr>
                                <td width="5%"/>
                                <td width="60%" style="vertical-align: bottom;">
                                    <span t-field="o.words2"/>
                                </td>
                                <td width="35%" height="34px" style="vertical-align: bottom;">
                                    <t t-if="o.currency_id.name != 'IDR'">
                                        <span t-field="o.amount"
                                              t-options="{&quot;widget&quot;: &quot;float&quot;, &quot;precision&quot;: 2}"/>
                                    </t>
                                    <t t-else="">
                                        <span t-field="o.amount"
                                              t-options="{&quot;widget&quot;: &quot;float&quot;, &quot;precision&quot;: 0}"/>
                                    </t>
                                </td>
                            </tr>
                        </table>
                    </div>
                </div>
            </div>
        </t>
    </template>
</odoo>