<odoo>
    <template id="report_debit_memo_mncp_container">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="o">
                <t t-call="ins_base_3tv_mncp.report_debit_memo_mncp_document"/>
            </t>
        </t>
    </template>
    
    <template id="report_debit_memo_mncp_document">
        <t t-call="web.basic_layout">
            <div class="page" style="font-size: 12px !important;">
                <div class="row">
                    <div class="col-12">
                        <table width="100%">
                            <tr>
                                <td width="33%" align="center" style="padding: 7px; vertical-align: middle; border: 1px solid black">
                                    <img t-att-src="image_data_uri(o.company_id.logo)" alt="Logo" style="max-height: 100px; max-width: 120px;"/>
                                </td>
                                <td width="77%" align="center" style="border: 1px solid black; padding: 7px; vertical-align: middle;">
                                    <h5><strong>DEBIT MEMO</strong></h5>
                                </td>
                            </tr>
                        </table>
                        <table width="100%" style="border: 1px solid black;">
                            <tr>
                                <td rowspan="5" width="60%" style="border: 1px solid black; padding: 5px;">
                                    <strong>TO</strong> : <br/>
                                    <span t-field="o.partner_id.name"/><br/>
                                    <span t-field="o.partner_id.street"/><br/>
                                    <span t-field="o.partner_id.country_id.name"/>
                                </td>
                                <td width="40%" style="border: 1px solid black; padding: 5px;">
                                    <strong>REFERENCE</strong> : <span t-field="o.payment_reference"/>
                                </td>
                            </tr>
                            <tr>
                                <td width="40%" style="border: 1px solid black; padding: 5px;">
                                    <strong>MO NO</strong> :
                                </td>
                            </tr>
                            <tr>
                                <td width="40%" style="border: 1px solid black; padding: 5px;">
                                    <strong>SALES</strong> :
                                </td>
                            </tr>
                            <tr>
                                <td width="40%" style="border: 1px solid black; padding: 5px;">
                                    <strong>ATTENTION</strong> :
                                </td>
                            </tr>
                            <tr>
                                <td width="40%" style="border: 1px solid black; padding: 5px;">
                                    <strong>INVOICE NO</strong> :
                                </td>
                            </tr>
                        </table>
                    </div>
                </div>
                <br/>

                <div class="row">
                    <div class="col-12">
                        <table width="100%" style="border: 1px solid black;">
                            <tr>
                                <td width="15%" align="center" style="border: 1px solid black; padding: 5px;">
                                    <strong>MEMO NUMBER</strong>
                                </td>
                                <td width="15%" align="center" style="border: 1px solid black; padding: 5px;">
                                    <strong>DATE</strong>
                                </td>
                                <td width="15%" align="center" style="border: 1px solid black; padding: 5px;">
                                    <strong>DUE DATE</strong>
                                </td>
                                <td width="15%" align="center" style="border: 1px solid black; padding: 5px;">
                                    <strong>CURRENCY</strong>
                                </td>
                                <td rowspan="2" width="40%" style="border: 1px solid black; padding: 5px;">
                                    <strong>CLAUSE :</strong><br/>
                                    <span t-field="o.partner_id.ref"/>
                                </td>
                            </tr>
                            <tr>
                                <td width="15%" align="center" style="border: 1px solid black; padding: 5px;">
                                    <span t-field="o.payment_reference"/>
                                </td>
                                <td width="15%" align="center" style="border: 1px solid black; padding: 5px;">
                                    <t t-esc="o.invoice_date.strftime('%d-%b-%y') if o.invoice_date else ''"/>
                                </td>
                                <td width="15%" align="center" style="border: 1px solid black; padding: 5px;">
                                    <t t-esc="o.invoice_date_due.strftime('%d-%b-%y') if o.invoice_date_due else ''"/>
                                </td>
                                <td width="15%" align="center" style="border: 1px solid black; padding: 5px;">
                                    <span t-field="o.currency_id.name"/>
                                </td>
                            </tr>
                        </table>
                    </div>
                </div>
                <br/>

                <div class="row">
                    <div class="col-12">
                        <table width="100%">
                        <t t-set="num" t-value="1"/>
                            <tr>
                                <td width="5%" align="center" style="border: 1px solid black; padding: 5px;">
                                    <strong>NO</strong>
                                </td>
                                <td width="65%" align="center" style="border: 1px solid black; padding: 5px;">
                                    <strong>DESCRIPTION</strong>
                                </td>
                                <td width="15%" align="center" style="border: 1px solid black; padding: 5px;">
                                    <strong>UNIT PRICE</strong>
                                </td>
                                <td width="15%" align="center" style="border: 1px solid black; padding: 5px;">
                                    <strong>TOTAL PRICE</strong>
                                </td>
                            </tr>
                            <tr t-foreach="o.invoice_line_ids" t-as="line">
                                <td width="5%" align="center" style="border: 1px solid black; padding: 5px;">
                                    <span t-esc="num"/>
                                    <t t-set="num" t-value="num+1"/>
                                </td>
                                <td width="65%" style="border: 1px solid black; padding: 5px;">
                                    <span t-field="line.name"/>
                                </td>
                                <td width="15%" align="right" style="border: 1px solid black; padding: 5px;">
                                    <t t-esc="'{:,.0f}'.format(int(line.price_unit))"/>
                                </td>
                                <t t-if="o.currency_id.name != 'IDR'">
                                    <td width="15%" align="right" style="border: 1px solid black; padding: 5px;">
                                        <t t-esc="line.price_subtotal" t-options='{"widget": "float", "precision": 2}'/>
                                    </td>
                                </t>
                                <t t-else="">
                                    <td width="15%" align="right" style="border: 1px solid black; padding: 5px;">
                                        <t t-esc="line.price_subtotal" t-options='{"widget": "float", "precision": 0}'/>
                                    </td>
                                </t>
                            </tr>
                            <tr>
                                <td colspan="2">
                                    &#160;
                                </td>
                                <td width="15%" style="border: 1px solid black; padding: 5px;">
                                    <strong>AMOUNT</strong>
                                </td>
                                <t t-if="o.currency_id.name != 'IDR'">
                                    <td width="15%" align="right" style="border: 1px solid black; padding: 5px;">
                                        <t t-esc="o.amount_untaxed" t-options='{"widget": "float", "precision": 2}'/>
                                    </td>
                                </t>
                                <t t-else="">
                                    <td width="15%" align="right" style="border: 1px solid black; padding: 5px;">
                                        <t t-esc="o.amount_untaxed" t-options='{"widget": "float", "precision": 0}'/>
                                    </td>
                                </t>
                            </tr>
                            <tr>
                                <td colspan="2">
                                    &#160;
                                </td>
                                <td width="15%" style="border: 1px solid black; padding: 5px;">
                                    <strong>VAT</strong>
                                </td>
                                <t t-if="o.currency_id.name != 'IDR'">
                                    <td width="15%" align="right" style="border: 1px solid black; padding: 5px;">
                                        <t t-esc="o.amount_tax" t-options='{"widget": "float", "precision": 2}'/>
                                    </td>
                                </t>
                                <t t-else="">
                                    <td width="15%" align="right" style="border: 1px solid black; padding: 5px;">
                                        <t t-esc="o.amount_tax" t-options='{"widget": "float", "precision": 0}'/>
                                    </td>
                                </t>
                            </tr>
                            <tr>
                                <td colspan="2">
                                    &#160;
                                </td>
                                <td width="15%" style="border: 1px solid black; padding: 5px;">
                                    <strong>TOTAL AMOUNT</strong>
                                </td>
                                <t t-if="o.currency_id.name != 'IDR'">
                                    <td width="15%" align="right" style="border: 1px solid black; padding: 5px;">
                                        <t t-esc="o.amount_total" t-options='{"widget": "float", "precision": 2}'/>
                                    </td>
                                </t>
                                <t t-else="">
                                    <td width="15%" align="right" style="border: 1px solid black; padding: 5px;">
                                        <t t-esc="o.amount_total" t-options='{"widget": "float", "precision": 0}'/>
                                    </td>
                                </t>
                            </tr>
                        </table>
                    </div>
                </div>
                <br/>

                <!-- Custom signature -->
                <div class="row">
                    <div class="col-6 text-left">
                        <strong>SAYS : <span t-field="o.amount_in_words"/><br/><br/><br/></strong>
                        <strong>APPROVED BY</strong>
                        <br/><br/><br/><br/><br/><br/><br/>
                        <t t-if="o.move_type == 'out_invoice'">
                            <span t-field="o.assignee_id_invoice.name"/><br/>
                            <span t-field="o.assignee_id_invoice.job_position"/>
                        </t>
                        <t t-if="o.move_type == 'in_invoice'">
                            <span t-field="o.assignee_id_bill.name"/><br/>
                            <span t-field="o.assignee_id_bill.job_position"/>
                        </t>
                    </div>
                    <div class="col-6 text-left" style="font-size:11px">
                        Payment by Transfer/ Cheque / Bilyet Giro to<br/><br/>
                        PT. Media Nusantara Citra Tbk<br/>
                        MNC Tower, JL. KEBON SIRIH NO. 17-19<br/>
                        KEBON SIRIH, MENTENG JAKARTA PUSAT 10340<br/><br/>
                        Bank MNC Internasional - Menteng<br/>
                        A/c : 100 01 00000 90736 (IDR)<br/>
                        A/c : 100 01 00000 15435 (USD) Swift Code : BUMIDJA<br/><br/>
                        Bank BRI<br/>
                        A/c : 020601003212301 (IDR)<br/><br/>
                        Bank Muamalat(IDR) - Kantor Pusat Muamalat Tower<br/>
                        A/c : 301 019 7940 (IDR)<br/>
                        A/n : PT MEDIA NUSANTARA CITRA TBK
                        <br/><br/>
                        <p style="border: 1px solid black;">
                            MOHON MENCANTUMKAN NOMOR MEMO SAAT MELAKUKAN PEMBAYARAN / PLEASE ATTACH THE MEMO NUMBER OF THE PAYMENT
                        </p>
                    </div>
                </div>

                <div class="footer text-right">
                    <small>
                        <span>Page</span>
                        <span class="page" />
                        of
                        <span class="topage" />
                    </small>
                </div>

            </div>
        </t>
    </template>
</odoo>
