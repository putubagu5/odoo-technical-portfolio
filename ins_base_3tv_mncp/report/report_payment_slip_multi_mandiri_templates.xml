<odoo>
    <template id="report_payment_slip_multi_mandiri_container">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="o">
                <t t-call="ins_base_3tv_mncp.report_payment_slip_multi_mandiri_document"/>
            </t>
        </t>
    </template>

    <template id="report_payment_slip_multi_mandiri_document">
        <t t-call="web.basic_layout">
            <div class="page" style="font-size: 14px; !important;">
                <table width="100%">
                    <!-- LEFT INFORMATIONS -->
                    <td width="50%">
                        <table width="100%">
                            <tr>
                                <td width="65%" height="380px"/>
                                <td width="35%" style="vertical-align: bottom">
                                    <span>Penerima</span>
                                </td>
                            </tr>
                        </table>
                        <table width="100%">
                            <tr>
                                <td width="15%" height="65px"/>
                                <td width="85%" style="vertical-align: bottom">
                                    <span>No. Pelanggan</span>
                                </td>
                            </tr>
                        </table>
                        <table width="100%">
                            <tr>
                                <td width="33%" height="75px"/>
                                <td width="67%" style="vertical-align: bottom;">
                                    <span>Penyetor</span>
                                </td>
                            </tr>
                        </table>
                        <table width="100%">
                            <tr>
                                <td width="15%"/>
                                <td width="85%" style="vertical-align: bottom;">
                                    <span>Alamat</span>
                                </td>
                            </tr>
                        </table>
                        <table width="100%">
                            <tr>
                                <td width="15%"/>
                                <td width="85%" height="55px" style="vertical-align: bottom">
                                    <span>Tujuan Transaksi</span>
                                </td>
                            </tr>
                        </table>
                    </td>

                    <!-- RIGHT INFORMATION -->
                    <td width="50%">
                        <table width="100%">
                            <tr>
                                <td width="35%" height="280"/>
                                <td width="65%" style="vertical-align: bottom; letter-spacing: 5px">
                                    <span>000 - 000</span>
                                </td>
                            </tr>
                        </table>
                        <table width="100%">
                            <tr>
                                <td width="10%" height="65px"/>
                                <td width="90%" style="vertical-align: bottom; text-align: right">
                                    <t t-if="o.currency_id.name != 'IDR'">
                                        <span t-field="o.amount"
                                              t-options="{&quot;widget&quot;: &quot;float&quot;, &quot;precision&quot;: 2}"/>
                                    </t>
                                    <t t-else="">
                                        <span t-field="o.amount"
                                              t-options="{&quot;widget&quot;: &quot;float&quot;, &quot;precision&quot;: 0}"/>
                                    </t>
                                </td>
                            </tr>
                        </table>
                        <table width="100%">
                            <tr>
                                <td width="10%" height="75px"/>
                                <td width="90%" style="vertical-align: bottom">
                                    <span t-field="o.amount_in_words_2"/>
                                    <br/>
                                    <span t-field="o.assignee1_id_slip.name"/>
                                    <span t-field="o.assignee2_id_slip.name"/>
                                </td>
                            </tr>
                        </table>
                    </td>
                </table>
            </div>
        </t>
    </template>
</odoo>
