                    </div>
                </div>
                <br/>

                <div class="row">
                    <div class="col-12">
                        <table width="100%">
                            <tr>
                                <td width="33%" align="center" style="padding: 7px; vertical-align: middle; border: 1px solid black">
                                    <img src="/ins_base_3tv_mncp/static/src/img/mnc_invosa.jpg" style="max-height: 100px; max-width: 120px;"/>
                                </td>
                                <td width="34%" align="center" style="border: 1px solid black; padding: 7px; vertical-align: middle; font-family:Arial; font-size:18pt; font-weight: bold; ">
                                    PAYMENT ORDER (PO)
