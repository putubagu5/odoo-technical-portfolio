<odoo>
    <template id="ins_base_3tv_mncp_report_payment_order_3tv_container">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="o">
                <t t-call="ins_base_3tv_mncp.ins_base_3tv_mncp_report_payment_order_3tv_document"/>
            </t>
        </t>
    </template>

