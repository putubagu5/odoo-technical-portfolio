                                <td width="1%" style="padding: 2px;">
                                    :
                                </td>
                                <td width="39%" style="padding: 2px; border-right: 1px solid black;">
                                    <t t-if="o.other_name">
                                        <span t-field="o.sudo().partner_id.alias_name"/> / <span t-field="o.other_name"/>
                                    </t>
                                    <t t-else="">
                                        <span t-field="o.sudo().partner_id.alias_name"/>
                                    </t>
                                </td>
                                <td width="10%" style="padding: 2px;">
                                    PO Date
                                </td>
                                <td width="1%" style="padding: 2px;">
                                    :
                                </td>
                                <td width="14%" style="padding: 2px;">
                                    <t t-esc="o.date_order.strftime('%d-%b-%y') if o.date_order else ''"/>
                                </td>
                                <td width="25%" style="padding: 2px;">
                                    Delivery Address:
                                </td>
                            </tr>
                            <tr>
                                <td style="padding: 2px;">
                                    Address
                                </td>
                                <td style="padding: 2px;">
                                    :
                                </td>
                                <td style="padding: 2px; border-right: 1px solid black;">
                                    <span t-esc="o.sudo().partner_id.street"/>,&#160;<span t-esc="o.sudo().partner_id.city"/><br/>
                                    <span t-esc="o.sudo().partner_id.state_id.name"/>&#160;<span t-esc="o.sudo().partner_id.zip"/>,&#160;<span t-esc="o.sudo().partner_id.country_id.name"/><br/>
                                </td>
                                <td style="padding: 2px;">
                                    PO No<br/>
                                    Reference<br/>
                                    Revision<br/>
                                    Currency
                                </td>
                                <td style="padding: 2px;">
                                    :<br/>
                                    :<br/>
                                    :<br/>
                                    :
                                </td>
                                <td style="padding: 0px;">
                                    <span t-field="o.name"/><br/>
                                    <span t-field="o.partner_ref"/><br/>
                                    <span t-field="o.revision"/><br/>
                                    <span t-field="o.currency_id.name"/>
                                </td>
                                <td style="padding: 0px;">
                                    <span t-esc="company.name"/><br/>
                                    <span t-esc="company.street"/>,&#160;<span t-esc="company.city"/><br/>
                                    <span t-esc="company.state_id.name"/>&#160;<span t-esc="company.zip"/>,&#160;<span t-esc="company.country_id.name"/><br/>
                                    Tax number: <span t-esc="company.vat"/>
                                </td>
                            </tr>
                            <tr>
                                <td style="padding: 2px;">
                                    NPWP No.
                                </td>
                                <td style="padding: 2px;">
                                    :
                                </td>
                                <td style="padding: 2px; border-right: 1px solid black;">
                                    <span t-field="o.sudo().partner_id.npwp"/>
                                </td>
                                <td style="padding: 2px;">
                                    &#160;
                                </td>
                                <td style="padding: 2px;">
                                    &#160;
                                </td>
                                <td style="padding: 2px;">
                                    &#160;
                                </td>
                                <td style="padding: 2px;">
                                    &#160;
                                </td>
                            </tr>
                            <tr>
                                <td style="padding: 2px;">
                                    Telephone
                                </td>
                                <td style="padding: 2px;">
                                    :
                                </td>
                                <td style="padding: 2px; border-right: 1px solid black;">
                                    <span t-field="o.sudo().partner_id.phone"/>
                                </td>
                                <td style="padding: 2px;">
                                    &#160;
                                </td>
                                <td style="padding: 2px;">
                                    &#160;
                                </td>
                                <td style="padding: 2px;">
                                    &#160;
                                </td>
                                <td style="padding: 2px;">
                                    &#160;
                                </td>
                            </tr>
                            <tr>
                                <td style="padding: 2px;">
                                    Fax
                                </td>
                                <td style="padding: 2px;">
                                    :
                                </td>
                                <td style="padding: 2px; border-right: 1px solid black;">
                                    <span t-field="o.sudo().partner_id.phone"/>
                                </td>
                                <td style="padding: 2px;">
                                    &#160;
                                </td>
                                <td style="padding: 2px;">
                                    &#160;
                                </td>
                                <td style="padding: 2px;">
                                    &#160;
                                </td>
                                <td style="padding: 2px;">
                                    &#160;
                                </td>
                            </tr>
                            <tr>
                                <td style="padding: 2px;">
                                    Email
                                </td>
                                <td style="padding: 2px;">
                                    :
                                </td>
                                <td style="padding: 2px; border-right: 1px solid black;">
                                    <span t-field="o.sudo().partner_id.email"/>
                                </td>
                                <td colspan="3" style="border: 1px solid black; padding: 2px;">
                                <t t-if="o.state in ('draft', 'sent', 'to approve')">
                                    Status : In Progress
                                </t>
                                </td>
                                <td style="border: 1px solid black; padding: 2px;">
                                    Requestor : <span t-field="o.request_user_id.name"/>
                                </td>
                            </tr>
                        </table>
                    </div>
                </div>
                <br/>

                <div class="row first-page">
                    <div class="col-12">
                        <table width="100%" style="border-top: 1px solid black; font-family:Arial; font-size:14px;">
                            <tr>
                                <td width="100%">
                                    <strong>Purchase Order Description:</strong> <span t-field="o.po_description"/>
                                </td>
                            </tr>
                        </table>
                    </div>
                </div>
            </div>

            <div class="page" style="font-family:Arial; font-size:14px;">
                <div class="row">
                    <div class="col-12">
                        <table width="100%">
                        <t t-set="num" t-value="1"/>
                            <tr style="background-color: #d0c8c8; padding-left:5px; padding-bottom:1px; padding-top:1px;">
                                <td width="5%" align="center" style="border: 1px solid black;">
                                    <strong>No</strong>
                                </td>
                                <td width="55%" align="center" style="border: 1px solid black;">
                                    <strong>Item Description</strong>
                                </td>
                                <td width="5%" align="center" style="border: 1px solid black;">
                                    <strong>Qty</strong>
                                </td>
                                <td width="5%" align="center" style="border: 1px solid black;">
                                    <strong>UOM</strong>
                                </td>
                                <td width="15%" align="center" style="border: 1px solid black;">
                                    <strong>Unit Price</strong>
                                </td>
                                <td width="15%" align="center" style="border: 1px solid black;">
                                    <strong>Total Price</strong>
                                </td>
                            </tr>
                            <tr t-foreach="o.order_line.filtered(lambda line: line.qty_cancel == 0)" t-as="line" style="padding-left:5px; padding-bottom:1px; padding-top:1px;">
                                <td width="5%" align="center" style="padding-left:5px; padding-right:5px; border: 1px solid black;">
                                    <span t-esc="num"/>
                                    <t t-set="num" t-value="num+1"/>
                                </td>
                                <td width="55%" style="border: 1px solid black; padding-left:5px; padding-right:5px;">
                                    <!-- <t t-set="desc" t-value="line.name.split(']') if line.name else ''"/>
                                    <t t-esc="desc[1] if desc[1] else line.name"/> -->
                                    <span t-field="line.name"/>
                                </td>
                                <td width="5%" align="center" style="border: 1px solid black; padding-left:5px; padding-right:5px;">
                                    <span t-esc="'{:,.0f}'.format(int(line.product_qty))"/>
                                </td>
                                <td width="5%" align="center" style="border: 1px solid black; padding-left:5px; padding-right:5px;">
                                    <span t-field="line.product_uom.name"/>
                                </td>
                                <t t-if="o.currency_id.name != 'IDR'">
                                    <td width="15%" align="right" style="border: 1px solid black; padding-left:5px; padding-right:5px;">
                                        <t t-esc="line.price_unit" t-options="{&quot;widget&quot;: &quot;float&quot;, &quot;precision&quot;: 2}"/>
                                    </td>
                                    <td width="15%" align="right" style="border: 1px solid black; padding-left:5px; padding-right:5px;">
                                        <t t-esc="line.price_subtotal" t-options="{&quot;widget&quot;: &quot;float&quot;, &quot;precision&quot;: 2}"/>
                                    </td>
                                </t>
                                <t t-else="">
                                    <td width="15%" align="right" style="border: 1px solid black; padding-left:5px; padding-right:5px;">
                                        <t t-esc="line.price_unit" t-options="{&quot;widget&quot;: &quot;float&quot;, &quot;precision&quot;: 0}"/>
                                    </td>
                                    <td width="15%" align="right" style="border: 1px solid black; padding-left:5px; padding-right:5px;">
                                        <t t-esc="line.price_subtotal" t-options="{&quot;widget&quot;: &quot;float&quot;, &quot;precision&quot;: 0}"/>
                                    </td>
                                </t>
                            </tr>
                            <tr style="padding:3px; padding-bottom:1px; padding-top:1px;">
                                <td colspan="4">
                                    &#160;
                                </td>
                                <td width="15%" align="right" style="border: 1px solid black; padding: 5px;">
                                    <strong>Subtotal</strong>
                                </td>
                                <t t-if="o.currency_id.name != 'IDR'">
                                    <td width="15%" align="right" style="border: 1px solid black; padding-left:5px; padding-right:5px;">
                                        <t t-esc="o.amount_untaxed" t-options="{&quot;widget&quot;: &quot;float&quot;, &quot;precision&quot;: 2}"/>
                                    </td>
                                </t>
                                <t t-else="">
                                    <td width="15%" align="right" style="border: 1px solid black; padding-left:5px; padding-right:5px;">
                                        <t t-esc="o.amount_untaxed" t-options="{&quot;widget&quot;: &quot;float&quot;, &quot;precision&quot;: 0}"/>
                                    </td>
                                </t>
                            </tr>
                            <tr style="padding:3px; padding-bottom:1px; padding-top:1px;">
                                <td colspan="4">
                                    &#160;
                                </td>
                                <td width="15%" align="right" style="border: 1px solid black; padding-left:5px; padding-right:5px;">
                                    <strong>Discount</strong>
                                </td>
                                <td width="15%" align="right" style="border: 1px solid black; padding-left:5px; padding-right:5px;">
                                    &#160;
                                </td>
                            </tr>
                            <tr style="padding:3px; padding-bottom:1px; padding-top:1px;">
                                <td colspan="4">
                                    &#160;
                                </td>
                                <td width="15%" align="right" style="border: 1px solid black; padding-left:5px; padding-right:5px;">
                                    <strong>VAT</strong>
                                </td>
                                <t t-if="o.currency_id.name != 'IDR'">
                                    <td width="15%" align="right" style="border: 1px solid black; padding-left:5px; padding-right:5px;">
                                        <t t-esc="o.amount_tax" t-options="{&quot;widget&quot;: &quot;float&quot;, &quot;precision&quot;: 2}"/>
                                    </td>
                                </t>
                                <t t-else="">
                                    <td width="15%" align="right" style="border: 1px solid black; padding-left:5px; padding-right:5px;">
                                        <t t-esc="o.amount_tax" t-options="{&quot;widget&quot;: &quot;float&quot;, &quot;precision&quot;: 0}"/>
                                    </td>
                                </t>
                            </tr>
                            <tr style="padding:3px; padding-bottom:1px; padding-top:1px;">
                                <td colspan="4">
                                    &#160;
                                </td>
                                <td width="15%" align="right" style="border: 1px solid black; padding-left:5px; padding-right:5px;">
                                    <strong>Grand Total</strong>
                                </td>
                                <t t-if="o.currency_id.name != 'IDR'">
                                    <td width="15%" align="right" style="border: 1px solid black; padding-left:5px; padding-right:5px;">
                                        <t t-esc="o.amount_total" t-options="{&quot;widget&quot;: &quot;float&quot;, &quot;precision&quot;: 2}"/>
                                    </td>
                                </t>
                                <t t-else="">
                                    <td width="15%" align="right" style="border: 1px solid black; padding-left:5px; padding-right:5px;">
                                        <t t-esc="o.amount_total" t-options="{&quot;widget&quot;: &quot;float&quot;, &quot;precision&quot;: 0}"/>
                                    </td>
                                </t>
                            </tr>
                        </table>
                    </div>
                </div>
                <br/>

                <!-- Custom signature -->
                <div class="row">
                    <div class="col-12">
                        <table width="100%" style="border-top: 1px solid black; border-bottom: 1px solid black; border-left: 1px solid black; border-right: 1px solid black; font-family:Arial; font-size:10pt;">
                            <tr style="border-bottom: 1px solid black;">
                                <td width="13%" style="border-right: 1px solid black;">
                                    <strong>Amount :</strong>
                                </td>
                                <td width="87%">
