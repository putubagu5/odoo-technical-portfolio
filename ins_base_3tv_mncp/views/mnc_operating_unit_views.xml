<odoo>
    <data>
        <record id="view_mnc_operating_unit_form" model="ir.ui.view">
            <field name="name">view.mnc.operating.unit.form</field>
            <field name="model">mnc.operating.unit</field>
            <field name="arch" type="xml">
                <form>
                    <sheet>
                        <group>
                            <group>
                                <field name="name" required="1"/>
                                <field name="note" required="1"/>
                            </group>
                        </group>
                    </sheet>
                </form>
            </field>
        </record>

        <record id="view_mnc_operating_unit_tree" model="ir.ui.view">
            <field name="name">view.mnc.operating.unit.tree</field>
            <field name="model">mnc.operating.unit</field>
            <field name="arch" type="xml">
                <tree>
                    <field name="name"/>
                    <field name="note"/>
                </tree>
            </field>
        </record>

        <record id="action_mnc_operating_unit" model="ir.actions.act_window">
            <field name="name">Operating Unit</field>
            <field name="res_model">mnc.operating.unit</field>
            <field name="view_mode">tree,form</field>
        </record>

        <menuitem
            id="menu_mnc_operating_unit"
            name="Operating Unit"
            action="action_mnc_operating_unit"
            parent="account.menu_finance_configuration"/>
    </data>
</odoo>
