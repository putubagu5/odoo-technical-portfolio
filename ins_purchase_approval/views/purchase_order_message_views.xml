<odoo>
    <data>
        <record id="view_purchase_order_message_form" model="ir.ui.view">
            <field name="name">view.purchase.order.message.form</field>
            <field name="model">purchase.order.message</field>
            <field name="arch" type="xml">
                <form>
                    <sheet>
                        <group>
                            <group>
                                <field name="employee_id" required="1"/>
                                <field name="date"/>
                                <field name="note"/>
                                <field name="state" required="1"/>
                            </group>
                        </group>
                    </sheet>
                </form>
            </field>
        </record>

        <record id="view_purchase_order_message_tree" model="ir.ui.view">
            <field name="name">view.purchase.order.message.tree</field>
            <field name="model">purchase.order.message</field>
            <field name="arch" type="xml">
                <tree editable="bottom">
                    <field name="employee_id" required="1"/>
                    <field name="date"/>
                    <field name="note"/>
                    <field name="state" required="1"/>
                </tree>
            </field>
        </record>
    </data>
</odoo>
