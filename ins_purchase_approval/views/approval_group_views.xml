<odoo>
    <data>
        <record id="view_approval_group_form" model="ir.ui.view">
            <field name="name">view.approval.group.form</field>
            <field name="model">approval.group</field>
            <field name="arch" type="xml">
                <form>
                    <sheet>
                        <div class="oe_title">
                            <h1>
                                <field name="name" required="1"/>
                            </h1>
                        </div>
                        <group>
                            <group>
                                <field name="group_type" required="1"/>
                                <field name="amount_limit" required="1"/>
                            </group>
                            <group>
                                <field name="company_id" required="1"/>
                                <field name="currency_id" required="1"/>
                            </group>
                        </group>
                    </sheet>
                </form>
            </field>
        </record>

        <record id="view_approval_group_tree" model="ir.ui.view">
            <field name="name">view.approval.group.tree</field>
            <field name="model">approval.group</field>
            <field name="arch" type="xml">
                <tree>
                    <field name="name"/>
                    <field name="group_type"/>
                    <field name="amount_limit"/>
                    <field name="company_id"/>
                    <field name="currency_id"/>
                </tree>
            </field>
        </record>

        <record id="action_view_approval_group" model="ir.actions.act_window">
            <field name="name">Approval Group</field>
            <field name="res_model">approval.group</field>
            <field name="view_mode">tree,form</field>
        </record>

        <menuitem
            id="menu_approval_group"
            name="Approval Group"
            action="action_view_approval_group"
            parent="ins_purchase_approval.menu_root_approval"
            sequence="1"/>
    </data>
</odoo>