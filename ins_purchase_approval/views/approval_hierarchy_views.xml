<odoo>
    <data>
        <record id="view_approval_hierarchy_form" model="ir.ui.view">
            <field name="name">view.approval.hierarchy.form</field>
            <field name="model">approval.hierarchy</field>
            <field name="arch" type="xml">
                <form create="false" edit="false" delete="false">
                    <sheet>
                        <div class="oe_title">
                            <h1>
                                <field name="name" required="1"/>
                            </h1>
                        </div>
                        <group>
                            <group>
                                <field name="module" required="1"/>
                                <field name="company_id" required="1"/>
                            </group>
                        </group>
                        <notebook>
                            <page name="details" string="Details">
                                <field name="line_ids"/>
                            </page>
                        </notebook>
                    </sheet>
                </form>
            </field>
        </record>

        <record id="view_approval_hierarchy_form_system" model="ir.ui.view">
            <field name="name">view.approval.hierarchy.form.system</field>
            <field name="model">approval.hierarchy</field>
            <field name="inherit_id" ref="view_approval_hierarchy_form"/>
            <field name="groups_id" eval="[(6, 0, [ref('base.group_system')])]"/>
            <field name="arch" type="xml">
                <xpath expr="//form" position="attributes">
                    <attribute name="create">true</attribute>
                    <attribute name="edit">true</attribute>
                    <attribute name="delete">true</attribute>
                </xpath>
            </field>
        </record>

        <record id="view_approval_hierarchy_tree" model="ir.ui.view">
            <field name="name">view.approval.hierarchy.tree</field>
            <field name="model">approval.hierarchy</field>
            <field name="arch" type="xml">
                <tree create="false" edit="false" delete="false">
                    <field name="name"/>
                    <field name="module"/>
                    <field name="company_id"/>
                </tree>
            </field>
        </record>

        <record id="view_approval_hierarchy_tree_system" model="ir.ui.view">
            <field name="name">view.approval.hierarchy.tree.system</field>
            <field name="model">approval.hierarchy</field>
            <field name="inherit_id" ref="view_approval_hierarchy_tree"/>
            <field name="groups_id" eval="[(6, 0, [ref('base.group_system')])]"/>
            <field name="arch" type="xml">
                <xpath expr="//tree" position="attributes">
                    <attribute name="create">true</attribute>
                    <attribute name="edit">true</attribute>
                    <attribute name="delete">true</attribute>
                </xpath>
            </field>
        </record>

        <record id="action_view_approval_hierarchy" model="ir.actions.act_window">
            <field name="name">Approval Hierarchy</field>
            <field name="res_model">approval.hierarchy</field>
            <field name="view_mode">tree,form</field>
        </record>

        <menuitem
            id="menu_approval_hierarchy"
            name="Approval Hierarchy"
            action="action_view_approval_hierarchy"
            parent="ins_purchase_approval.menu_root_approval"
            sequence="3"/>
    </data>
</odoo>
