<odoo>
    <data noupdate="1">
        <record id="cron_clean_purchase_order_cache" model="ir.cron">
            <field name="name">Clean Purchase Order Cache</field>
            <field name="model_id" ref="ins_purchase_approval.model_purchase_order_cache"/>
            <field name="state">code</field>
            <field name="code">model._purge_records()</field>
            <field name="user_id" ref="base.user_root"/>
            <field name="interval_number">1</field>
            <field name="interval_type">days</field>
            <field name="numbercall">-1</field>
            <field name="nextcall" eval="(DateTime.now() + timedelta(days=1)).strftime('%Y-%m-%d %H:%M:%S')" />
            <field name="doall" eval="False"/>
            <field name="priority">2</field>
        </record>
    </data>
</odoo>
