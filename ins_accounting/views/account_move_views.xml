<odoo>
    <data>
        <record id="view_move_form" model="ir.ui.view">
            <field name="name">view.move.form</field>
            <field name="model">account.move</field>
            <field name="inherit_id" ref="account.view_move_form"/>
            <field name="arch" type="xml">
                <!-- add transaction_type_id and subscription_id after payment_reference -->
                <!-- add reversed_entry_id also -->
                <xpath expr="//field[@name='payment_reference']" position="after">
                    <field name="transaction_type_id" context="{'show_view_search_more_transaction_type':True}" attrs="{'invisible': [('move_type', 'not in', ('out_invoice', 'out_refund', 'out_receipt'))], 'required': [('move_type', 'in', ('out_invoice', 'out_refund', 'out_receipt'))]}"/>
<!--                    <field name="reversed_entry_id" readonly="1" force_save="1" string="Reversed Move"/>-->
                    <field name="subscription_id" invisible="1"/>
                    <field name="voucher_no" attrs="{'readonly': [('state', '=', 'posted')]}"/>
                    <field name="account_ap_id" domain="[('user_type_id.name', '=', 'Payable')]" invisible="1"/>
                </xpath>
                <!-- add is_customer_deposit after partner_id -->
                <xpath expr="//field[@name='partner_id']" position="after">
                    <field name="is_customer_deposit" attrs="{'invisible': [('move_type', 'not in', ('out_invoice', 'out_refund', 'out_receipt'))]}"/>
                </xpath>
                <!-- <xpath expr="//field[@name='site_id']" position="after">
                    <field name="voucher_no"/>
                </xpath> -->
<!--            don't need button reverse journal cause have a new reverse journal module -->
<!--                <xpath expr="//button[@name='button_draft']" position="before">-->
<!--                   <button name="action_invoice_reverse" string='Reverse Journal'-->
<!--                        type='object' groups="account.group_account_invoice"-->
<!--                        context="{'refund_method': 'cancel'}"-->
<!--                        attrs="{'invisible': ['|','|', ('move_type', 'not in', ('out_invoice', 'in_invoice')), ('state', '!=', 'posted'),('payment_state', 'not in', ('not_paid'))]}"/>-->
<!--                </xpath>-->
                <!-- add new pag adjustment inside notebook -->
                <notebook position="inside">
                    <page string="Adjustment Invoice" attrs="{'invisible': [('move_type', '=', ('in_invoice'))]}">
                        <field name="adjustment_ids"/>
                            <tree editable="bottom" string="Adjustment Invoice">
                                <field name="name"/>
                            </tree>
                    </page>
                    <page string="Adjustment Invoice" invisible="1">
                        <field name="ap_adjustment_ids" invisible="1"/>
                            <!-- <tree editable="bottom" string="AP Adjustment Invoice">
                                <field name="name"/>
                            </tree> -->
                    </page>
                </notebook>
                <xpath expr="//field[@name='amount_residual']" position="before">
                    <field name="adjustment_amount" attrs="{'invisible': [('move_type', 'not in', ('out_invoice')), ('adjustment_amount', '=', 0)]}"/>
                </xpath>

                <!-- add in invoice_line_ids tree before product_id -->
                <xpath expr="//field[@name='invoice_line_ids']//tree//field[@name='product_id']" position="before">
                    <field name="line_number"/>
                </xpath>

                <!-- and change order in tree to line_number -->
                <xpath expr="//field[@name='invoice_line_ids']//tree" position="attributes">
                    <attribute name="default_order">line_number</attribute>
                </xpath>
            </field>
        </record>
    </data>
</odoo>
