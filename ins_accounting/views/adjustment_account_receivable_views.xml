<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record id="view_ar_adjustment_form" model="ir.ui.view">
            <field name="name">ar.adjustment.form</field>
            <field name="model">ar.adjustment</field>
            <field name="arch" type="xml">
                <form string="AR Adjustment" version="7">
                    <header>
                        <button name="action_post" string="Confirm" type="object"
                                class="oe_highlight"
                                attrs="{'invisible': [('state', 'not in', ('draft'))]}"/>
                        <button name="action_cancel" string="Cancel" type="object"
                                class="oe_highlight"
                                attrs="{'invisible': [('state', 'not in', ('draft','posted'))]}"/>
                        <field name="state" widget="statusbar"
                               statusbar_visible="draft,posted,cancel"/>
                    </header>
                    <sheet>
                        <group>
                            <group>
                                <field name="name" readonly="1" force_save="1"/>
                                <field name="journal_id"
                                       domain="[('type', 'in', ['general'])]"
                                       attrs="{'readonly': [('state', 'in', ('posted','cancel'))]}"/>
                                <field name="partner_id"
                                       attrs="{'readonly': ['|',('state', 'in', ('posted','cancel')),
                                       ('id', '&gt;',0)]}"/>
                                <field name="invoice_id"
                                       domain="[('partner_id', '=', partner_id),('move_type', '=', 'out_invoice'),
                                       ('state', '=', 'posted'), ('payment_state', '=', 'not_paid')]"
                                       attrs="{'readonly': ['|',('state', 'in', ('posted','cancel')),
                                       ('id', '&gt;',0)]}"/>
                                <field name="type_adjustment"
                                       attrs="{'readonly': [('state', 'in', ('posted','cancel'))]}"/>
                                <field name="total_amount" readonly="1" force_save="1"/>
                            </group>
                            <group>
                                <field name="date"
                                       attrs="{'readonly': [('state', 'in', ('posted','cancel'))]}"/>
                                <field name="description"/>
                                <field name="currency_id"
                                       attrs="{'readonly': [('state', 'in', ('posted', 'cancel'))]}"/>
                                <field name="operating_unit_id"
                                       options="{'no_create': True}"
                                       attrs="{'readonly': [('state', 'in', ('posted', 'cancel'))]}"/>
                                <field name="company_id" readonly="1" force_save="1"
                                       options="{'no_create': True}" groups="base.group_multi_company"
                                       attrs="{'readonly': [('state', 'in', ('posted', 'cancel'))]}"/>
                                <field name="transaction_date"
                                       attrs="{'readonly': [('state', 'in', ('posted','cancel'))]}"/>
                                <field name="move_id" required="0" readonly="1" force_save="1"/>
                            </group>
                        </group>
                         <notebook>
                            <page id="adjustment_tab" string="Adjustment LInes">
                                <field name="ar_adjustment_ids" string="Adjustment Lines">
                                    <tree editable="bottom" string="Adjustment List">
                                        <field name="line_type"
                                               attrs="{'readonly': [('state', 'in', ('posted','cancel'))]}"/>
                                        <field name="invoice_id" invisible="1"/>
                                        <field name="invoice_line_id"
                                               domain="[('move_id', '=', invoice_id), ('price_unit','&gt;', 1),
                                               ('tax_line_id','=', False)]"
                                               attrs="{'readonly': [('state', 'in', ('posted','cancel'))]}" />
                                        <field name="currency_id" readonly="1" force_save="1"/>
                                        <field name="invoice_amount"
                                               readonly="1" force_save="1"
                                               optional="show"/>
                                        <field name="amount"
                                               attrs="{'readonly': [('state', 'in', ('posted','cancel'))]}"/>
                                        <field name="account_id"
                                               readonly="1" force_save="1"
                                               optional="show"/>
                                        <field name="counterpart_account_id"
                                               readonly="1" force_save="1"
                                               optional="show"/>
                                        <field name="state" invisible="1"/>
                                        <field name="company_id" groups="base.group_multi_company" invisible="1"/>
                                    </tree>
                                </field>
                            </page>
                        </notebook>
                    </sheet>
                </form>
            </field>
        </record>

        <record id="view_ar_adjustment_tree" model="ir.ui.view">
            <field name="name">ar.adjustment.tree</field>
            <field name="model">ar.adjustment</field>
            <field name="arch" type="xml">
                <tree edit="false">
                    <field name="date"/>
                    <field name="name"/>
                    <field name="journal_id"/>
                    <field name="invoice_id"/>
                    <field name="type_adjustment"/>
                    <field name="total_amount" sum="total_Amount"/>
                    <field name="state"/>
                    <field name="operating_unit_id"/>
                    <field name="company_id" groups="base.group_multi_company"/>
                    <field name="currency_id" invisible="1"/>
                </tree>
            </field>
        </record>

        <record id="action_ar_adjustment" model="ir.actions.act_window">
            <field name="name">Adjustment Account Receivable</field>
            <field name="res_model">ar.adjustment</field>
            <field name="view_mode">tree,form</field>
            <field name="help" type="html">
                <p class="oe_view_nocontent_create">
                    There is no examples click here to add new Adjustment Account Receivable.
                </p>
            </field>
        </record>


        <menuitem id="ar_adjustment_menu"
                  name="AR Adjustment"
                  parent="account.menu_finance_receivables"
                  sequence="16"
                  action="action_ar_adjustment"/>

    </data>
</odoo>