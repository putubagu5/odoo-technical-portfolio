<odoo>
    <data>
        <record id="view_account_transaction_type_form" model="ir.ui.view">
            <field name="name">view.account.transaction.type.form</field>
            <field name="model">account.transaction.type</field>
            <field name="arch" type="xml">
                <form>
                    <sheet>
                        <div class="oe_title">
                            <label for="name" string="Transaction Type Name"/>
                            <h1>
                                <field name="name" required="1"/>
                            </h1>
                        </div>
                        <group>
                            <group>
                                <field name="description"/>
                                <field name="account_id" required="1"/>
                                <field name="company_id" required="1"/>
                            </group>
                        </group>
                    </sheet>
                </form>       
            </field>
        </record>

        <record id="view_account_transaction_type_tree" model="ir.ui.view">
            <field name="name">view.account.transaction.type.tree</field>
            <field name="model">account.transaction.type</field>
            <field name="arch" type="xml">
                <tree>
                    <field name="name"/>
                    <field name="description"/>
                    <field name="account_id"/>
                    <field name="company_id"/>
                </tree>
            </field>
        </record>

        <record id="action_view_account_transaction_type" model="ir.actions.act_window">
            <field name="name">Transaction Types</field>
            <field name="res_model">account.transaction.type</field>
            <field name="view_mode">tree,form</field>
        </record>

        <menuitem
            id="menu_account_transaction_type"
            name="Transaction Types"
            action="action_view_account_transaction_type"
            parent="account.account_account_menu"
            sequence="50"/>
    </data>
</odoo>