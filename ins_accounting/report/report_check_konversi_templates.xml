                                    <span t-field="o.acc_name"/>
                                </td>
                            </tr>
                        </table>
                        <table width="100%">
                            <tr>
                                <td width="15%"></td>
                                <td width="85%">
                                    <span t-field="o.words3"/>
                                </td>
                            </tr>
                        </table>
