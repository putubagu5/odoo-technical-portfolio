<odoo>
    <template id="report_payment_check_konversi_container">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="o">
                <t t-call="ins_accounting.report_payment_check_konversi_document"/>
            </t>
        </t>
    </template>

    <template id="report_payment_check_konversi_document">
