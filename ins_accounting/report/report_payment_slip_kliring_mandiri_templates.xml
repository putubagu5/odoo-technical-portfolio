<odoo>
    <template id="report_payment_slip_kliring_container">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="o">
                <t t-call="ins_accounting.report_payment_slip_kliring_mandiri_document"/>
            </t>
        </t>
    </template>

    <template id="ins_accounting.report_payment_slip_kliring_mandiri_document">
        <t t-call="web.basic_layout">
            <div class="page" style="font-size: 10px; font-family: Arial;">
                <table width="100%">
                    <!-- LEFT INFORMATIONS -->
                    <td width="50%">
                        <table width="100%">
                            <tr>
                                <td width="35%"></td>
                                <td width="65%" height="350px" style="vertical-align: bottom">
                                    <span t-field="o.company_id"/>
                                </td>
                            </tr>
                            <tr>
                                <td width="35%"></td>
                                <td width="65%">
                                    <span t-field="o.partner_bank_to"/>
                                </td>
                            </tr>
                            <tr>
                                <td width="35%"></td>
                                <td width="65%">
                                    <span t-field="o.bank_to"/>
                                </td>
                            </tr>
                            <tr>
                                <td width="35%"></td>
                                <td width="65%">
                                    <span t-field="o.company_id.street"/>
                                </td>
                            </tr>
                            <tr>
                                <td width="35%"></td>
                                <td width="65%">
                                    <span t-field="o.clearing_account_id"/>
                                </td>
                            </tr>
                        </table>
                    </td>

                    <!-- RIGHT INFORMATION -->
                    <td width="50%">
                        <table width="100%">
                            <tr>
                                <td width="30%" height="100px"></td>
                                <td width="70%" style="vertical-align: bottom">
                                    <span t-field="o.acc_name"/>
                                </td>
                            </tr>
                            <tr>
                                <td width="30%"></td>
                                <td width="70%">
                                    <span t-field="o.partner_id.street"/>
                                </td>
                            </tr>
                            <tr>
                                <td width="30%" height="70px"></td>
                                <td width="70%" style="vertical-align: bottom; letter-spacing: 5px">
                                    <span t-field="o.partner_bank_from"/>
                                </td>
                            </tr>
                        </table>
                        <table width="100%">
                            <tr>
                                <td width="15%" height="40px"></td>
                                <td width="75%" style="text-align: right; vertical-align: bottom">
                                    <t t-if="o.currency_id.name != 'IDR'">
                                        <span t-field="o.amount" t-options='{"widget": "float", "precision": 2}'/>
                                    </t>
                                    <t t-else="">
                                        <span t-field="o.amount" t-options='{"widget": "float", "precision": 0}'/>
                                    </t>
                                </td>
                                <td width="10%"></td>
                            </tr>
                            <tr>
                                <td width="15%" height="70px"></td>
                                <td width="75%" style="vertical-align: bottom">
                                    <span t-field="o.amount_in_words"/>
<!--                                    <br/>-->
<!--                                    <span t-field="o.assignee1_id_slip.name"/>-->
<!--                                    <span t-field="o.assignee2_id_slip.name"/>-->
                                </td>
                                <td width="10%"></td>
                            </tr>
                        </table>
                    </td>
                </table>
            </div>
        </t>
    </template>
</odoo>
