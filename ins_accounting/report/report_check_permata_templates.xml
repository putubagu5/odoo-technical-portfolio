<odoo>
    <template id="report_payment_check_permata_container">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="o">
                <t t-call="ins_accounting.report_payment_check_permata_document"/>
            </t>
        </t>
    </template>

    <template id="ins_accounting.report_payment_check_permata_document">
        <t t-call="web.basic_layout">
            <div class="page" style="font-size: 12px !important;">
                <!-- cheque contents -->
                <div class="row">
                    <div class="col-12">
                        <table width="100%">
                            <tr>
                                <td width="25%"/>
                                <td width="35%" height="33px"/>
                                <td width="40%">
                                    <span>Jakarta,
                                        <t t-esc="o.date_paid.strftime('%d-%b-%Y') if o.date_paid else ''"/>
                                    </span>
                                </td>
                            </tr>
                        </table>
                        <table width="100%">
                            <tr>
                                <td width="28%"/>
                                <td width="72%" height="32px" style="vertical-align: bottom;">
                                    <span t-field="o.acc_name"/>
                                </td>
                            </tr>
                        </table>
                        <table width="100%">
                            <tr>
                                <td width="27%"/>
                                <td width="73%" height="32px" style="vertical-align: middle;">
                                    <span t-field="o.words1"/>
                                </td>
                            </tr>
                        </table>
                        <table width="100%">
                            <tr>
                                <td width="7%"/>
                                <td width="53%" style="vertical-align: middle">
                                    <span t-field="o.words2"/>
                                </td>
                                <td width="40%" height="35px" style="vertical-align: middle;">
                                    <t t-if="o.currency_id.name != 'IDR'">
                                        <span t-field="o.amount" t-options="{&quot;widget&quot;: &quot;float&quot;, &quot;precision&quot;: 2}"/>
                                    </t>
                                    <t t-else="">
                                        <span t-field="o.amount" t-options="{&quot;widget&quot;: &quot;float&quot;, &quot;precision&quot;: 0}"/>
                                    </t>
                                </td>
                            </tr>
                        </table>
                    </div>
                </div>
            </div>
        </t>
    </template>
</odoo>