<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
    	<record id="purchase_request_inherit_form_view" model="ir.ui.view">
            <field name="name">purchase.request.inherit.form.view</field>
            <field name="model">purchase.request</field>
            <field name="inherit_id" ref="purchase_request.view_purchase_request_form"/>
            <field name="arch" type="xml">
            	<!-- add new fields cip_id and is_cip -->
            	<xpath expr="//field[@name='line_ids']//form/sheet/group[@name='main']//field[@name='product_id']" position="after">
            		<field name="is_cip" 
            			invisible="1"/>
            		<field name="cip_id" 
            			attrs="{
            				'required': [('is_cip','=', True)],
            				'invisible': [('is_cip','=', False)],
            				}"/>
            		<field name="project_cip_id" 
            			attrs="{
            				'required': [('is_cip','=', True)],
            				'invisible': [('is_cip','=', False)],
            				}"/>
            	</xpath>
            </field>
        </record>
    </data>
</odoo>