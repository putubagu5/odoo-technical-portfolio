<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record id="phase_project_cip_form_view" model="ir.ui.view">
            <field name="name">phase.project.cip.form</field>
            <field name="model">phase.project.cip</field>
            <field name="arch" type="xml">
                <form string="Phase Project CIP">
                    <sheet>
                        <group>
                            <group>
                                <field name="name" required="1"/>
                                <field name="code" required="1"/>
                                <field name="cip_id" required="1"/>
                                <field name="company_id" required="1"/>
                            </group>
                        </group>
                    </sheet>
                </form>
            </field>
        </record>

        <record id="phase_project_cip_tree_view" model="ir.ui.view">
            <field name="name">phase.project.cip.tree</field>
            <field name="model">phase.project.cip</field>
            <field name="arch" type="xml">
                <tree string="Phase Project CIP">
                    <field name="code"/>
                    <field name="name"/>
                    <field name="cip_id"/>
                    <field name="company_id" required="1"/>
                </tree>
            </field>
        </record>

        <record id="phase_project_cip_act_window" model="ir.actions.act_window">
            <field name="name">Phase Project CIP</field>
            <field name="type">ir.actions.act_window</field>
            <field name="res_model">phase.project.cip</field>
            <field name="view_mode">tree,form</field>
            <field name="help" type="html">
                <p class="oe_view_nocontent_create">
                    There is no examples click here to add new Phase Project CIP.
                </p>
            </field>
        </record>

        <menuitem name="Phase Project CIP"
                  id="phase_project_cip_menu"
                  parent="ins_asset.menu_asset"
                  action="phase_project_cip_act_window"/>

    </data>
</odoo>