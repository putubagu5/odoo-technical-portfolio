<odoo>
    <data>
        <record id="view_wizard_mass_cip_generate" model="ir.ui.view">
            <field name="name">view.wizard.mass.cip.generate</field>
            <field name="model">wizard.mass.cip.generate</field>
            <field name="arch" type="xml">
                <form>
                    <group>
                        <group>
                            <field name="model_id" domain="[('state', '=', 'model')]" attrs="{'invisible': [('is_post_cip', '=', False)], 'required': [('is_post_cip', '=', True)]}"/>
                            <field name="cip_id" required="1"/>
                            <field name="company_id"/>
                            <field name="journal_id" required="1"/>
                            <field name="analytic_account_id" />
                            <field name="type" invisible="1"/>
                        </group>
                        <group>
                            <field name="name"/>
                            <field name="date_acquisition" required="1"/>
                            <field name="amount_total"/>
                            <field name="is_post_cip"/>
                        </group>
                    </group>
                    <group>
                        <field name="line_ids" nolabel="1">
                            <tree editable="bottom" create="0" delete="1">
                                <field name="selected" widget="boolean_toggle"/>
                                <field name="company_id" invisible="1"/>
                                <field name="amount" required="1" optional="show"/>
                                <field name="price_unit" required="1" optional="hide"/>
                                <field name="purchase_id" domain="[('invoice_ids', '!=', False)]" optional="show"/>
                                <field name="purchase_line_number" optional="show"/>
                                <field name="partner_id" optional="hide"/>
                                <field name="picking_id" domain="[('purchase_id', '=', purchase_id)]" optional="show"/>
                                <field name="invoice_id" required="1" optional="show"/>
                                <field name="invoice_line_id" required="1" optional="show"/>
                                <field name="analytic_account_id" required="1" optional="show"/>
                                <field name="product_id" optional="show"/>
                                <field name="product_code" optional="hide"/>
                                <field name="qty" required="1" optional="show"/>
                                <field name="date_acquisition" required="1" optional="show"/>
                                <field name="model_id" invisible="1"/>
                                <field name="cip_id" optional="show"/>
                            </tree>
                        </field>
                    </group>
                    <footer>
                        <button name="button_generate" string="Generate Journal" type="object" class="btn-primary" attrs="{'invisible': [('is_post_cip', '=', True)]}"/>
                        <button name="button_generate_cip" string="Generate CIP Capitalization" type="object" class="btn-primary" attrs="{'invisible': [('is_post_cip', '=', False)]}"/>
                        <button string="Cancel" class="btn-default" special="cancel"/>
                    </footer>
                </form>
            </field>
        </record>

        <record id="action_wizard_mass_cip_generate" model="ir.actions.act_window">
            <field name="name">Generate CIP</field>
            <field name="res_model">wizard.mass.cip.generate</field>
            <field name="view_mode">form</field>
            <field name="target">new</field>
        </record>

        <menuitem
            id="menu_mass_cip_generate"
            name="Mass CIP Generate"
            action="action_wizard_mass_cip_generate"
            parent="ins_asset.menu_asset"
            sequence="2"/>
    </data>
</odoo>
