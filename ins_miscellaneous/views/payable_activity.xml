<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record id="payable_activities_form_view" model="ir.ui.view">
            <field name="name">payable.activities.form</field>
            <field name="model">receivable.activities</field>
            <field name="arch" type="xml">
                <form string="Payable Activities">
                    <group>
                        <group>
                            <field name="name" required="1"/>
                            <field name="description_name"/>
                            <field name="account_id" required="1"/>
                        </group>
                        <group>
                            <field name="type" required="1"/>
                            <field name="company_id" required="1"/>
                        </group>
                    </group>
                </form>
            </field>
        </record>

         <record id="payable_activities_tree_view" model="ir.ui.view">
            <field name="name">payable.activities.tree</field>
            <field name="model">receivable.activities</field>
            <field name="arch" type="xml">
                <tree string="Payable Activities">
                    <field name="name"/>
                    <field name="description_name"/>
                    <field name="account_id"/>
                    <field name="type"/>
                    <field name="company_id"/>
                </tree>
            </field>
        </record>

        <record id="payable_activity_act_window" model="ir.actions.act_window">
            <field name="name">Payable Activity</field>
            <field name="type">ir.actions.act_window</field>
            <field name="res_model">receivable.activities</field>
            <field name="view_mode">tree,form</field>
            <field name="domain">[('type', '=', 'payment')]</field>
            <field name="context">{'default_type': 'payment'}</field>
            <field name="help" type="html">
                <p class="oe_view_nocontent_create">
                    There is no examples click here to add new Payable Activity.
                </p>
            </field>
        </record>

        <record id="action_payable_activity_tree" model="ir.actions.act_window.view">
            <field eval="2" name="sequence"/>
            <field name="view_mode">tree</field>
            <field name="view_id" ref="payable_activities_tree_view"/>
            <field name="act_window_id" ref="payable_activity_act_window"/>
        </record>

        <record id="action_payable_activity_form" model="ir.actions.act_window.view">
            <field eval="3" name="sequence"/>
            <field name="view_mode">form</field>
            <field name="view_id" ref="payable_activities_form_view"/>
            <field name="act_window_id" ref="payable_activity_act_window"/>
        </record>

        <menuitem  name="Payable Activity"
                   id="payable_activity_menu"
                   action="payable_activity_act_window"
                   parent="ins_miscellaneous.menu_misc_payable"
                   sequence="20"/>
    </data>
</odoo>