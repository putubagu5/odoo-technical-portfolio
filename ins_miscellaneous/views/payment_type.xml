<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record id="payment_type_form_view" model="ir.ui.view">
            <field name="name">payment.type.form</field>
            <field name="model">receipt.type</field>
            <field name="arch" type="xml">
                <form string="Payment Type">
                    <group>
                        <group>
                            <field name="name" required="1"/>
                            <field name="account_id" required="1"/>
                            <field name="category" required="1"/>
                        </group>
                        <group>
                            <field name="type" required="1"/>
                            <field name="company_id" required="1"/>
                        </group>
                    </group>
                </form>
            </field>
        </record>

        <record id="payment_type_tree_view" model="ir.ui.view">
            <field name="name">payment.type.tree</field>
            <field name="model">receipt.type</field>
            <field name="arch" type="xml">
                <tree string="Payment Type">
                    <field name="name"/>
                    <field name="account_id"/>
                    <field name="category"/>
                    <field name="type"/>
                    <field name="company_id"/>
                </tree>
            </field>
        </record>

        <record id="payment_type_act_window" model="ir.actions.act_window">
            <field name="name">Payment Type</field>
            <field name="type">ir.actions.act_window</field>
            <field name="res_model">receipt.type</field>
            <field name="view_mode">tree,form</field>
            <field name="domain">[('type', '=', 'payment')]</field>
            <field name="context">{'default_type': 'payment'}</field>
            <field name="help" type="html">
                <p class="oe_view_nocontent_create">
                    There is no examples click here to add new Payment Type.
                </p>
            </field>
        </record>

        <record id="action_payment_type_tree" model="ir.actions.act_window.view">
            <field eval="11" name="sequence"/>
            <field name="view_mode">tree</field>
            <field name="view_id" ref="payment_type_tree_view"/>
            <field name="act_window_id" ref="payment_type_act_window"/>
        </record>

        <record id="action_payment_type_form" model="ir.actions.act_window.view">
            <field eval="12" name="sequence"/>
            <field name="view_mode">form</field>
            <field name="view_id" ref="payment_type_form_view"/>
            <field name="act_window_id" ref="payment_type_act_window"/>
        </record>

        <menuitem  name="Payment Type"
                   id="payment_type_menu"
                   action="payment_type_act_window"
                   parent="ins_miscellaneous.menu_misc_payable"
                   sequence="19"/>
    </data>
</odoo>