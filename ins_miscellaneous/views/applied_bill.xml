<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record id="view_applied_bill_form" model="ir.ui.view">
            <field name="name">applied.bill.form</field>
            <field name="model">applied.invoices</field>
            <field name="arch" type="xml">
                <form string="Apply Payment To Bill">
                    <header>
                        <field name="state" widget="statusbar" statusbar_visible="draft,posted"/>
                    </header>
                    <group>
                        <group>
                            <field name="misc_id" required="1" readonly="1" force_save="1"
                                   domain="[('misc_type', '=', ('payment'))]"
                                   attrs="{'readonly': [('state', 'in', ('posted', 'cancel'))]}"/>
                            <field name="misc_type" invisible="1"/>
                            <field name="misc_currency_id"/>
                            <field name="misc_remaining_amount"
                                   readonly="1"/>
                            <field name="transaction_type" readonly="1"
                                   context="{'search_default_transaction_type':'apply'}"/>
                            <field name="transaction_date"
                                   attrs="{'readonly': [('state', 'in', ('posted', 'cancel'))]}"/>
                            <field name="applied_amount" required="1"
                                   attrs="{'readonly': [('state', 'in', ('posted', 'cancel'))]}"/>
                            <field name="journal_id" widget="selection"
                                   domain="[('type', 'in', ('bank', 'cash'))]"
                                   attrs="{'readonly': [('state', 'in', ('posted', 'cancel'))]}"/>
                        </group>
                        <group>
                            <field name="date" string="Accounting Date"
                                       attrs="{'readonly': [('state', 'in', ('posted', 'cancel'))]}"/>
                            <field name="invoice_id" string="Purchase Invoice"
                                   domain="[('move_type', '=', 'in_invoice'),('state', '=', 'posted'),
                                   ('payment_state', 'in', ('not_paid','partial')), ('amount_residual_signed', '>', 0),
                                   ('partner_id', '=', misc_partner_id)]"
                                   attrs="{'readonly': [('state', 'in', ('posted', 'cancel'))]}"/>
                            <field name="misc_partner_id" invisible="1"/>
                            <field name="partner_id"/>
                            <field name="invoice_currency_id"/>
                            <field name="invoice_amount"/>
                            <field name="company_id"/>
                            <field name="operating_unit_id"/>
                            <field name="applied_amount_currency"
                                   readonly="1"/>
                            <field name="move_id" required="0"
                                   attrs="{'invisible': [('id', '=', False)]}"
                                   groups="account.group_account_readonly"/>
                        </group>
                    </group>
                    <footer>
                        <button string="Applied Payment"
                                name="action_applied_bill"
                                attrs="{'invisible': [('move_id', '&gt;', 1),('misc_type','=', 'receive')]}"
                                type="object" class="oe_highlight"/>
                        <button string="Unapplied Payment"
                                name="action_unapplied_bill"
                                attrs="{'invisible': ['&amp;', '|', '|', ('misc_type', '=', 'receive'),
                                ('id', '=', False), ('move_id', '=', False), ('state', '=', 'cancel')]}"
                                type="object" class="oe_highlight"/>
                        <button string="Cancel" class="btn btn-secondary" special="cancel"/>
                    </footer>
                </form>
            </field>
        </record>

         <record id="applied_bill_tree_view" model="ir.ui.view">
            <field name="name">applied.bill.tree</field>
            <field name="model">applied.invoices</field>
            <field name="arch" type="xml">
                <tree string="Applied Bill">
                    <field name="name"/>
                    <field name="misc_id"/>
                    <field name="transaction_type"/>
                    <field name="transaction_date"/>
                    <field name="applied_amount"/>
                    <field name="journal_id"/>
                    <field name="invoice_id"/>
                    <field name="invoice_amount"/>
                    <field name="move_id"/>
                    <field name="operating_unit_id"/>
                    <field name="company_id"/>
                    <field name="state"/>
                </tree>
            </field>
        </record>

    </data>
</odoo>