<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <!-- Sequences for miscellaneous.receipt -->
        <record id="seq_miscellaneous_receipt" model="ir.sequence">
            <field name="name">Misc Receipt</field>
            <field name="code">miscellaneous.receipt</field>
            <field name="prefix">MR</field>
            <field name="padding">5</field>
            <field name="company_id" eval="False"/>
        </record>
        <!-- Sequences for miscellaneous.payment -->
        <record id="seq_miscellaneous_payment" model="ir.sequence">
            <field name="name">Misc Payment</field>
            <field name="code">miscellaneous.payment</field>
            <field name="prefix">MP</field>
            <field name="padding">5</field>
            <field name="company_id" eval="False"/>
        </record>

    </data>
</odoo>