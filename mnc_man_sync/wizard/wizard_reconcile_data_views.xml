<?xml version="1.0"?>
<odoo>

    <record id="wizard_mnc_reconcile_data_form" model="ir.ui.view">
        <field name="name">wizard.mnc.reconcile.data.form</field>
        <field name="model">wizard.mnc.reconcile.data</field>
        <field name="arch" type="xml">
            <form>
                <group>
                    <group>
                        <field name="month" placeholder="Select Month"/>
                        <field name="company_id" options="{'no_create': True, 'no_open': True}" required="1"/>
                    </group>
                    <group>
                        <field name="year" placeholder="Select Year"/>
                    </group>
                </group>
                <footer>
                    <!--                    <button name="get_data" string="Get Data" type="object" class="oe_highlight"/>-->
                    <button name="action_reconcile" string="Reconcile" type="object" class="oe_highlight"/>
                    <button string="Cancel" class="oe_link" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <record model="ir.actions.act_window" id="action_wizard_reconcile_data">
        <field name="name">Reconcile Data</field>
        <field name="res_model">wizard.mnc.reconcile.data</field>
        <field name="type">ir.actions.act_window</field>
        <field name="view_mode">form</field>
        <field name="view_id" ref="wizard_mnc_reconcile_data_form"/>
        <field name="target">new</field>
    </record>

    <menuitem id="atis_reconcile_data_menu"
              name="Reconcile Asset"
              parent="mnc_man_sync.mnc_atis_reconcile_root"
              action="action_wizard_reconcile_data"
              sequence="1"/>


</odoo>