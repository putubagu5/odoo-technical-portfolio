<?xml version="1.0"?>
<odoo>

    <record id="wizard_atis_fix_asset_report_form" model="ir.ui.view">
        <field name="name">wizard.atis.fix.asset.report.form</field>
        <field name="model">wizard.atis.fix.asset.report</field>
        <field name="arch" type="xml">
            <form>
                <group>
                    <group>
                        <field name="company_id" options="{'no_create': True, 'no_open': True}" required="1"/>
                        <field name="is_date_range"/>
                        <label for="start_date" attrs="{'invisible': [('is_date_range','!=',True)]}" string="Dates"/>
                        <div class="o_row" attrs="{'invisible': [('is_date_range','!=',True)]}">
                            <field name="start_date" placeholder="Start Date"
                                   attrs="{'required': [('is_date_range','=',True)]}"/>
                            <span class="oe_inline">&#160;-&#160;</span>
                            <field name="end_date" placeholder="End Date"
                                   attrs="{'required': [('is_date_range','=',True)]}"/>
                        </div>
                        <label for="month" string="As of Period" attrs="{'invisible': [('is_date_range','=',True)]}"/>
                        <div class="o_row" attrs="{'invisible': [('is_date_range','=',True)]}">
                            <field name="month" placeholder="Select Month"
                                   attrs="{'required': [('is_date_range','!=',True)]}"/>
                            <span class="oe_inline">&#160;-&#160;</span>
                            <field name="year" placeholder="Select Year"
                                   attrs="{'required': [('is_date_range','!=',True)]}"/>
                        </div>
<!--                        <field name="book_type" placeholder="Book Type"/>-->
                    </group>
                </group>
                <footer>
                    <button name="button_print_excel" string="Download Excel" type="object" class="oe_highlight"/>
                    <button string="Cancel" class="oe_link" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <record model="ir.actions.act_window" id="action_wizard_atis_fix_asset_report">
        <field name="name">ATIS Fixed Asset Reconciled</field>
        <field name="res_model">wizard.atis.fix.asset.report</field>
        <field name="type">ir.actions.act_window</field>
        <field name="view_mode">form</field>
        <field name="view_id" ref="wizard_atis_fix_asset_report_form"/>
        <field name="target">new</field>
    </record>

    <menuitem id="mnc_atis_report_root"
              name="ATIS Report"
              parent="mnc_sync_logger_root"
              sequence="5"/>

    <menuitem id="menu_atis_asset_report" parent="mnc_atis_report_root" name="Report Fix Asset"
              action="action_wizard_atis_fix_asset_report" sequence="100"/>

</odoo>