<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <!--r12_po_receives-->
        <record id="ir_cron_po_receives" model="ir.cron">
            <field name="name">atis - r12-po-receives</field>
            <field name="model_id" ref="model_r12_po_receives"/>
            <field name="state">code</field>
            <field name="code">model.send_all_to_atis()</field>
            <field name="user_id" ref="base.user_root"/>
            <field name='interval_number'>1</field>
            <field name='interval_type'>months</field>
            <field name="numbercall">-1</field>
            <field name="active" eval="False"/>
            <field name="doall" eval="False"/>
            <field name="nextcall"
                   eval="(DateTime.now() + relativedelta(day=1, months=1)).strftime('%Y-%m-%d 23:59:59')"/>
            <!--            <field name="nextcall" eval="(datetime.now() + timedelta(days=5)).strftime('%Y-%m-%d 23:59:59')"/>-->
        </record>

