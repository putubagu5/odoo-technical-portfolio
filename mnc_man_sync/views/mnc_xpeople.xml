<odoo>
    <data>

        <record id="mnc_x_people_tree" model="ir.ui.view">
            <field name="name">x.people.tree</field>
            <field name="model">x.people</field>
            <field name="arch" type="xml">
                <tree create="0" edit="0" delete="1">
                    <field name="source_data"/>
                    <field name="org_id"/>
                    <field name="full_name"/>
                    <field name="employee_number"/>
                    <field name="person_id"/>
                    <field name="sync_log_id"/>
                    <field name="curr_steps"/>
                    <field name="total_steps"/>
                </tree>
            </field>
        </record>

        <record id="mnc_x_people_action" model="ir.actions.act_window">
            <field name="name">X People</field>
            <field name="type">ir.actions.act_window</field>
            <field name="res_model">x.people</field>
            <field name="view_mode">tree</field>
            <field name="help" type="html">
                <p class="o_view_nocontent_smiling_face">
                    Empty Data
                </p>
            </field>
        </record>


        <menuitem id="mnc_x_people_menu"
                name="X People"
                parent="mnc_sync_logger_table"
                action="mnc_x_people_action"
                sequence="1"/>

    </data>
</odoo>