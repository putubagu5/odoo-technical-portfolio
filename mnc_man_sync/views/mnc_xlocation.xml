<odoo>
    <data>

        <record id="mnc_x_location_tree" model="ir.ui.view">
            <field name="name">x.location.tree</field>
            <field name="model">x.location</field>
            <field name="arch" type="xml">
                <tree create="0" edit="0" delete="1">
                    <field name="source_data"/>
                    <field name="org_id"/>
                    <field name="location_code"/>
                    <field name="description"/>
                    <field name="location_id"/>
                    <field name="sync_log_id"/>
                    <field name="curr_steps"/>
                    <field name="total_steps"/>
                </tree>
            </field>
        </record>

        <record id="mnc_x_location_action" model="ir.actions.act_window">
            <field name="name">X Location</field>
            <field name="type">ir.actions.act_window</field>
            <field name="res_model">x.location</field>
            <field name="view_mode">tree</field>
            <field name="help" type="html">
                <p class="o_view_nocontent_smiling_face">
                    Empty Data
                </p>
            </field>
        </record>

        <menuitem id="mnc_x_location_menu"
                name="X Location"
                parent="mnc_sync_logger_table"
                action="mnc_x_location_action"
                sequence="1"/>

    </data>
</odoo>