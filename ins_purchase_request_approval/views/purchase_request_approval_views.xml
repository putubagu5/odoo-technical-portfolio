<odoo>
    <data>
        <record id="view_purchase_request_approval_form" model="ir.ui.view">
            <field name="name">view.purchase.request.approval.form</field>
            <field name="model">purchase.request.approval</field>
            <field name="arch" type="xml">
                <form>
                    <sheet>
                        <group>
                            <group>
                                <field name="department_id" invisible="1"/>
                                <field name="job_id" invisible="1"/>
                                <field name="approval_group_id"/>
                                <field name="employee_id" required="1"/>
                                <field name="level" required="1"/>
                                <field name="state" required="1"/>
                                <field name="date"/>
                                <field name="note"/>
                                <field name="is_forward"/>
                            </group>
                        </group>
                    </sheet>
                </form>
            </field>
        </record>

        <record id="view_purchase_request_approval_tree" model="ir.ui.view">
            <field name="name">view.purchase.request.approval.tree</field>
            <field name="model">purchase.request.approval</field>
            <field name="arch" type="xml">
                <tree editable="bottom">
                    <field name="level" string="Sequence"/>
                    <field name="employee_id" required="1"/>
                    <field name="state" required="1"/>
                    <field name="approval_group_id"/>
                    <field name="date"/>
                    <field name="note"/>
                    <field name="is_forward"/>
                </tree>
            </field>
        </record>
    </data>
</odoo>
